(ns test.vibe-test
  (:require [test :refer :all]
            [string]
            [legmacs.buffer :as buf]
            ;; Loaded so the catalog's editor-libs block is populated the
            ;; same way a real session sees them (vibe itself only requires
            ;; buffer/keymap; modeline/theme/modes live elsewhere).
            [legmacs.modeline]
            [legmacs.theme]
            [legmacs.modes]
            [legmacs.minibuffer]
            [legmacs.modes.prog]
            ;; :refer too, mirroring main.lg: eval-vibe-form `eval`s the
            ;; form in whatever namespace is current, so `vibe` has to
            ;; resolve here for the error-path test to reach the real fn.
            [legmacs.vibe :as vibe :refer [vibe]]))

;; Nothing here touches the network: the interesting parts of legmacs.vibe
;; (finding the call site, building the prompt, splicing the answer back)
;; are pure, and the one impure function is exercised only on the paths
;; that fail before any HTTP happens.

(deftest parse-config-is-forgiving
  (testing "the expected shape"
    (is (= {:key "sk-x" :model "gpt-5.6-luna"}
           (vibe/parse-config "{:key \"sk-x\" :model \"gpt-5.6-luna\"}"))))

  (testing "comments and whitespace, since it's a file people hand-edit"
    (is (= {:key "sk-x"}
           (vibe/parse-config "\n;; my key\n{:key \"sk-x\"}\n"))))

  (testing "no file at all"
    (is (= {} (vibe/parse-config nil))))

  (testing "a blank or half-finished file is no config, not a crash"
    (is (= {} (vibe/parse-config "   \n")))
    (is (= {} (vibe/parse-config "{:key \"sk-x\"")))
    (is (= {} (vibe/parse-config "[:not :a :map]")))))

(deftest api-key-prefers-the-config-file
  (let [provider (:openai vibe/providers)]
    (testing "vibe.edn's :key wins"
      (is (= "sk-from-file" (vibe/api-key {:key "sk-from-file"} provider))))

    (testing "an empty :key falls through rather than being sent as a key"
      ;; OPENAI_API_KEY may or may not be set in whatever shell runs the
      ;; suite, so only assert the thing that's true either way.
      (is (not= "" (vibe/api-key {:key ""} provider))))))

(deftest strip-fences-peels-one-outer-fence
  (testing "a plain reply is returned as-is, just trimmed"
    (is (= "(+ 1 2)" (vibe/strip-fences "  (+ 1 2)\n"))))

  (testing "a fence with a language tag"
    (is (= "(+ 1 2)" (vibe/strip-fences "```clojure\n(+ 1 2)\n```"))))

  (testing "a fence with no language tag"
    (is (= "(+ 1 2)" (vibe/strip-fences "```\n(+ 1 2)\n```"))))

  (testing "prose before the fence is left alone -- that reply wasn't just code"
    (is (string/starts-with? (vibe/strip-fences "Sure!\n```\n(+ 1 2)\n```")
                             "Sure!"))))

(deftest find-vibe-form-locates-the-call-site
  (let [text "(defn f [] (vibe \"a thing\"))"
        open (string/index-of text "(vibe")
        ;; the text ends "))" -- the inner close (the vibe form's own) is
        ;; the second-to-last char, the outer one closes the defn.
        end (dec (count text))]

    (testing "point inside the form"
      (is (= [open end] (vibe/find-vibe-form text (+ open 3)))))

    (testing "point on the opening paren"
      (is (= [open end] (vibe/find-vibe-form text open))))

    (testing "point just past the closing paren, like C-x C-e"
      (is (= [open end] (vibe/find-vibe-form text end))))

    (testing "point outside the form entirely"
      (is (nil? (vibe/find-vibe-form text 2)))))

  (testing "the innermost (vibe ...) wins when they nest"
    (let [text "(vibe (str (vibe \"inner\")))"
          inner (string/index-of text "(vibe \"inner\")")
          [s _e] (vibe/find-vibe-form text (+ inner 2))]
      (is (= inner s))))

  (testing "a form spanning lines"
    (let [text "(vibe\n  \"multi\n   line\")"]
      (is (= [0 (count text)] (vibe/find-vibe-form text 3)))))

  (testing "a name that merely starts with vibe is not a vibe call"
    (is (nil? (vibe/find-vibe-form "(vibes \"x\")" 3)))
    (is (nil? (vibe/find-vibe-form "(vibe-later \"x\")" 3))))

  (testing "an unbalanced form has no match to splice over"
    (is (nil? (vibe/find-vibe-form "(vibe \"x\"" 3)))))

(deftest context-text-marks-the-call-site
  (let [text "(defn f [] (vibe \"a thing\"))"
        [s e] (vibe/find-vibe-form text 14)]
    (testing "the call is swapped for the marker, the rest survives verbatim"
      (is (= (str "(defn f [] " vibe/marker ")")
             (vibe/context-text text s e))))))

(deftest user-message-carries-the-file-and-the-column
  (let [msg (vibe/user-message "make it go" {:text (str "  " vibe/marker)
                                             :filename "foo.lg"
                                             :column 2})]
    (is (string/includes? msg "make it go"))
    (is (string/includes? msg "foo.lg"))
    (is (string/includes? msg vibe/marker))
    (is (string/includes? msg "column 2")))

  (testing "no buffer context (a bare REPL call) says so instead of lying"
    (let [msg (vibe/user-message "make it go" nil)]
      (is (string/includes? msg "make it go"))
      (is (not (string/includes? msg vibe/marker))))))

(deftest splice-offsets-replaces-across-lines-in-one-undo-step
  (let [s (buf/new-state nil ["(defn f []" "  (vibe \"x\"))"])
        text (buf/buffer-text s)
        [start end] (vibe/find-vibe-form text 15)
        s* (vibe/splice-offsets s start end "(+ 1\n     2)")]

    (testing "the replacement lands in place of the form"
      (is (= ["(defn f []" "  (+ 1" "     2))"] (:lines s*))))

    (testing "point ends up right after the inserted code"
      (is (= 2 (:cursor-row s*)))
      (is (= 7 (:cursor-col s*))))

    (testing "one undo restores the whole thing"
      (is (= ["(defn f []" "  (vibe \"x\"))"] (:lines (buf/undo s*)))))

    (testing "the buffer is marked modified"
      (is (:modified? s*))))

  (testing "a read-only buffer refuses the splice"
    (let [s (assoc (buf/new-state nil ["(vibe \"x\")"]) :read-only? true)
          s* (vibe/splice-offsets s 0 10 "42")]
      (is (= ["(vibe \"x\")"] (:lines s*)))
      (is (= "Buffer is read-only" (:message s*))))))

(deftest vibe-replace-records-the-request-without-performing-it
  (testing "point in a vibe form arms an async job, not a blocking pending-task"
    (let [s (-> (buf/new-state nil ["(vibe \"a thing\")"])
                (assoc :cursor-col 8))
          s* (vibe/vibe-replace s)]
      (is (= "vibing..." (:message s*)))
      (is (nil? (:pending-task s*)))
      (is (seq (:async-jobs s*)))
      (is (= ["(vibe \"a thing\")"] (:lines s*)))))

  (testing "nowhere near a vibe form"
    (let [s* (vibe/vibe-replace (buf/new-state nil ["(+ 1 2)"]))]
      (is (nil? (:async-jobs s*)))
      (is (string/includes? (:message s*) "No (vibe")))))

(deftest resolve-vibe-fails-safely
  (testing "a request whose form has since moved is dropped, not misapplied"
    (let [s (buf/new-state nil ["(+ 1 2)"])
          s* (vibe/resolve-vibe s 0 7 {:ok "42"})]
      (is (= ["(+ 1 2)"] (:lines s*)))
      (is (string/includes? (:message s*) "moved"))))

  (testing "an :err outcome is reported, not spliced"
    (let [s (buf/new-state nil ["(vibe \"a thing\")"])
          s* (vibe/resolve-vibe s 0 16 {:err "unknown vibe provider :nope"})]
      (is (= ["(vibe \"a thing\")"] (:lines s*)))
      (is (string/includes? (:message s*) "vibe error"))
      (is (string/includes? (:message s*) "unknown vibe provider"))))

  (testing "a long API error is not truncated; the echo area wraps it"
    (let [msg (apply str (repeat 80 "xy"))
          s (buf/new-state nil ["(vibe \"a thing\")"])
          s* (vibe/resolve-vibe s 0 16 {:err (str "HTTP 400: " msg)})]
      (is (string/includes? (:message s*) msg))
      (is (not (string/includes? (:message s*) "...")))))

  (testing "a string outcome splices over the form"
    (let [s (buf/new-state nil ["(vibe \"a thing\")"])
          s* (vibe/resolve-vibe s 0 16 {:ok "42"})]
      (is (= ["42"] (:lines s*)))
      (is (string/includes? (:message s*) "vibed"))))

  (testing "eval-vibe-form throws before HTTP when the provider is unknown"
    (let [saved @vibe/config]
      (try
        (swap! vibe/config assoc :provider :nope)
        (let [err (try (vibe/eval-vibe-form "(vibe \"a thing\")" {})
                       nil
                       (catch e e))]
          (is (some? err))
          (is (string/includes? (str (or (ex-message err) err)) "unknown vibe provider")))
        (finally (reset! vibe/config saved))))))

(defn- with-ns [ns-sym f]
  (let [saved (ns-name *ns*)
        outcome (try {:ok (do (in-ns ns-sym) (f))} (catch e {:err e}))]
    (in-ns saved)
    (if (contains? outcome :err) (throw (:err outcome)) (:ok outcome))))

(deftest vibe-resolves-after-switching-namespace
  ;; Regression: C-c C-v evals the (vibe ...) form in whatever *ns* is
  ;; current. After `(ns weather)` that is no longer legmacs.main, so
  ;; unqualified `vibe` used to fail with "Can't resolve vibe".
  (testing "a freshly created ns still resolves unqualified vibe"
    (is (some? (with-ns 'vibe-test-fresh-ns (fn [] (resolve 'vibe))))))

  (testing "eval-vibe-form in that ns fails on the provider, not on resolving vibe"
    (let [saved @vibe/config]
      (try
        (swap! vibe/config assoc :provider :nope)
        (let [err (with-ns 'vibe-test-eval-ns
                    (fn []
                      (try (vibe/eval-vibe-form "(vibe \"a thing\")" {})
                           nil
                           (catch e e))))]
          (is (some? err))
          (let [msg (str (or (ex-message err) err))]
            (is (string/includes? msg "unknown vibe provider"))
            (is (not (string/includes? msg "Can't resolve vibe")))))
        (finally (reset! vibe/config saved))))))

(deftest context-is-cleared-after-use
  (testing "with-context restores *vibe-context* even when the body throws"
    (try (vibe/with-context {:text "x"} (fn [] (throw "boom"))) (catch e nil))
    (is (nil? vibe/*vibe-context*))))

(deftest default-system-prompt-steers-away-from-jvm-clojure
  (let [p vibe/default-system-prompt]
    (is (string/includes? p "string/join"))
    (is (string/includes? p "clojure.string"))
    (is (string/includes? p "docstring"))
    (is (string/includes? p "ns-publics"))
    (is (string/includes? p "this editor"))
    (is (string/includes? p "defcommand"))
    (is (string/includes? p "register-modeline-segment!"))
    (is (string/includes? p "os/sh returns"))
    (is (string/includes? p "every frame"))
    (is (string/includes? p "(.Format (now)"))
    (is (string/includes? p "let-go.core/now"))
    (is (string/includes? p "Do not add an (ns"))))

(deftest namespace-catalog-lists-live-stdlib
  (let [cat (vibe/namespace-catalog)]
    (is (string/includes? cat "string:"))
    (is (string/includes? cat "join"))
    (is (string/includes? cat "json:"))
    (is (string/includes? cat "read-json"))))

(deftest namespace-catalog-lists-editor-scripting
  (let [cat (vibe/namespace-catalog)]
    (is (string/includes? cat "Editor scripting"))
    (is (string/includes? cat "legmacs.modeline:"))
    (is (string/includes? cat "register-modeline-segment!"))
    (is (string/includes? cat "legmacs.keymap:"))
    (is (string/includes? cat "string:"))))

(deftest user-message-includes-the-namespace-catalog
  (let [msg (vibe/user-message "make it go" nil)]
    (is (string/includes? msg "----- namespaces -----"))
    (is (string/includes? msg "string:"))))

(deftest user-message-scratch-carries-editor-catalog
  (testing "no ns form still includes the editor block, so a top-level vibe in *scratch* can emit register-modeline-segment!"
    (let [msg (vibe/user-message "clock on the modeline"
                                 {:text vibe/marker
                                  :filename "*scratch*"
                                  :column 0})]
      (is (string/includes? msg "*scratch*"))
      (is (not (string/includes? msg "This file's ns form requires:")))
      (is (string/includes? msg "Editor scripting"))
      (is (string/includes? msg "legmacs.modeline:")))))

(deftest user-message-lists-the-file-requires
  (let [text (str "(ns foo\n  (:require [string]\n            [json]))\n" vibe/marker)
        msg (vibe/user-message "x" {:text text :filename "foo.lg" :column 0})]
    (is (string/includes? msg "This file's ns form requires:"))
    (is (string/includes? msg "json"))))

(deftest rewrite-clojure-ns-uses-canonical-names
  (testing "the prefixes models actually emit"
    (is (= "string/join" (vibe/rewrite-clojure-ns "clojure.string/join")))
    (is (= "map" (vibe/rewrite-clojure-ns "clojure.core/map")))
    (is (= "async/chan" (vibe/rewrite-clojure-ns "clojure.core.async/chan")))
    (is (= "io/slurp" (vibe/rewrite-clojure-ns "clojure.java.io/slurp"))))

  (testing "strings and comments are left alone"
    (is (= "\"clojure.string/join\""
           (vibe/rewrite-clojure-ns "\"clojure.string/join\"")))
    (is (= ";; clojure.string/join"
           (vibe/rewrite-clojure-ns ";; clojure.string/join")))))

(deftest qualified-prefixes-skip-strings-and-keywords
  (is (= ["string" "os"]
         (vibe/qualified-prefixes "(defn f [] (string/join (os/getenv \"FOO/BAR\")))")))
  (is (= [] (vibe/qualified-prefixes ":string/foo")))
  (is (= [] (vibe/qualified-prefixes "\"string/join\""))))

(deftest ns-require-index-reads-libspecs
  (let [idx (vibe/ns-require-index
             "(ns foo\n  (:require [string]\n            [legmacs.buffer :as buf]\n            [json :as json]))")]
    (is (= #{"string" "legmacs.buffer" "json"} (:libs idx)))
    (is (= {"buf" "legmacs.buffer" "json" "json"} (:aliases idx))))

  (testing "no ns form"
    (is (= {:libs #{} :aliases {}} (vibe/ns-require-index "(+ 1 2)")))))

(deftest ensure-requires-edits-the-ns-form
  (testing "creates a :require clause when the ns form has none"
    (is (= "(ns foo\n  (:require [string]))"
           (vibe/ensure-requires "(ns foo)" ["string"]))))

  (testing "appends to a one-line :require"
    (is (= "(ns foo (:require [string] [json]))"
           (vibe/ensure-requires "(ns foo (:require [string]))" ["json"]))))

  (testing "does not duplicate a lib that is already required"
    (is (= "(ns foo (:require [string]))"
           (vibe/ensure-requires "(ns foo (:require [string]))" ["string"]))))

  (testing "a file with no ns form is left alone"
    (is (= "(string/join x)"
           (vibe/ensure-requires "(string/join x)" ["string"])))))

(deftest needed-libs-skips-aliases-and-unknowns
  (let [file "(ns foo\n  (:require [legmacs.buffer :as buf]\n            [string]))"]
    (is (= ["json"]
           (vibe/needed-libs "(json/read-json s)" file)))
    (is (= []
           (vibe/needed-libs "(buf/insert-string s \"x\")" file)))
    (is (= []
           (vibe/needed-libs "(string/join \",\" xs)" file)))
    (is (= []
           (vibe/needed-libs "(no-such-ns/foo)" file)))))

(deftest call-tool-inspects-the-live-runtime
  (is (string/includes? (vibe/call-tool "list-namespaces" {}) "string"))
  (is (string/includes? (vibe/call-tool "ns-publics" {"ns" "string"}) "join"))
  (is (string/includes? (vibe/call-tool "ns-publics" {:ns "json"}) "read-json"))
  (is (string/includes? (vibe/call-tool "var-doc" {"name" "string/join"})
                        "string/join"))
  (is (string/includes? (vibe/call-tool "ns-publics" {"ns" "nope"})
                        "no such namespace"))
  (is (string/includes? (vibe/call-tool "mystery" {}) "unknown tool")))

(deftest resolve-vibe-adds-missing-requires-in-one-undo
  (let [s (buf/new-state nil ["(ns foo)" "" "(vibe \"x\")"])
        text (buf/buffer-text s)
        [start end] (vibe/find-vibe-form text 12)
        s* (vibe/resolve-vibe s start end
                              {:ok "(defn bar [] (string/join \",\" xs))"})
        out (buf/buffer-text s*)]
    (testing "the code lands and the ns form gains the require"
      (is (string/includes? out "(:require [string])"))
      (is (string/includes? out "(defn bar [] (string/join \",\" xs))"))
      (is (string/includes? (:message s*) "required string")))

    (testing "one undo restores the vibe form and the original ns"
      (is (= ["(ns foo)" "" "(vibe \"x\")"] (:lines (buf/undo s*))))))

  (testing "clojure.string/ in the reply is rewritten before the require is added"
    (let [s (buf/new-state nil ["(ns foo)" "(vibe \"x\")"])
          text (buf/buffer-text s)
          [start end] (vibe/find-vibe-form text 10)
          s* (vibe/resolve-vibe s start end {:ok "clojure.string/join"})
          out (buf/buffer-text s*)]
      (is (string/includes? out "string/join"))
      (is (not (string/includes? out "clojure.string")))
      (is (string/includes? out "[string]")))))

(deftest http-error-text-pulls-the-api-message
  (testing "OpenAI's nested error.message, not the raw JSON"
    (is (= "Function tools with reasoning_effort are not supported"
           (vibe/http-error-text
            "{\"error\":{\"message\":\"Function tools with reasoning_effort are not supported\",\"type\":\"invalid_request_error\"}}"))))

  (testing "a non-JSON body is returned flattened, not truncated"
    (let [raw (str "oops\n" (apply str (repeat 80 "z")))]
      (is (string/includes? (vibe/http-error-text raw) "zzzz"))
      (is (not (string/includes? (vibe/http-error-text raw) "\n")))
      (is (not (string/includes? (vibe/http-error-text raw) "..."))))))

(deftest openai-api-picks-responses-unless-the-url-is-chat-completions
  (testing "the default, and an explicit override"
    (is (= :responses (vibe/openai-api {})))
    (is (= :chat-completions (vibe/openai-api {:api :chat-completions})))
    (is (= :responses (vibe/openai-api {:api :responses}))))

  (testing "a llama.cpp-style url infers the older shape"
    (is (= :chat-completions
           (vibe/openai-api {:url "http://127.0.0.1:8080/v1/chat/completions"})))))

(deftest openai-body-speaks-responses-by-default
  (let [body (vibe/openai-body {:model "gpt-5.6-luna"
                                :system "sys"
                                :messages [{:role "user" :content "hi"}]
                                :max-tokens 8192
                                :tools vibe/vibe-tools
                                :reasoning-effort :high})]
    (is (= "sys" (:instructions body)))
    (is (vector? (:input body)))
    (is (= {:effort "high"} (:reasoning body)))
    (is (= 8192 (:max_output_tokens body)))
    (is (false? (:store body)))
    (is (= "function" (:type (first (:tools body)))))
    (is (= "list-namespaces" (:name (first (:tools body)))))
    (is (nil? (:messages body)))
    (is (nil? (:reasoning_effort body)))))

(deftest openai-chat-completions-body-still-exists
  (let [body (vibe/openai-body {:api :chat-completions
                                :model "gpt-5.6-luna"
                                :system "sys"
                                :messages [{:role "user" :content "hi"}]
                                :max-tokens 100
                                :tools vibe/vibe-tools
                                :reasoning-effort :high})]
    (testing "tools on chat/completions coerce effort to none"
      (is (= "none" (:reasoning_effort body)))
      (is (seq (:messages body)))
      (is (nil? (:input body))))))

(deftest openai-responses-parse-reads-output-items
  (testing "plain text"
    (let [p (vibe/openai-responses-parse
             {"output" [{"type" "message"
                         "content" [{"type" "output_text" "text" "(+ 1 2)"}]}]})]
      (is (= "(+ 1 2)" (:content p)))
      (is (= [] (:tool-calls p)))))

  (testing "a function_call keeps the raw output so the next turn can echo it"
    (let [item {"type" "function_call"
                "call_id" "call_1"
                "name" "ns-publics"
                "arguments" "{\"ns\":\"os\"}"}
          p (vibe/openai-responses-parse {"output" [item]})]
      (is (= "ns-publics" (:name (first (:tool-calls p)))))
      (is (= "os" (get (:args (first (:tool-calls p))) "ns")))
      (is (= [item] (:output p))))))

(deftest effort-str-accepts-keywords-and-strings
  (is (= "medium" (vibe/effort-str :medium)))
  (is (= "high" (vibe/effort-str "high")))
  (is (nil? (vibe/effort-str nil))))
