;; legmacs.modes.letgo — a small REPL built into the editor: evaluate
;; let-go code straight out of the buffer, live, in the same process.
;;
;; This works because let-go's `eval`/`read-string` compile and run an
;; already-read form *in whatever namespace is current* -- and that's
;; legmacs.main the whole time legmacs is running, so code typed here sees
;; exactly the aliases main.lg set up: `buf/`, `keys/`, `km/`, `dispatch/`,
;; `render/`, plus clojure.core and let-go.core (now, spy, …) unqualified.
;; It's not a sandboxed toy evaluator -- it's the running editor's own
;; namespace. C-c C-e / *repl* eval form-by-form the same way (let-go's
;; load-string compiles in clojure.core, which does not refer let-go.core).
;;
;; Which is also why `preserving-ns` below exists: that invariant isn't
;; free. Evaluating a buffer that opens with `(ns foo)` -- every real
;; .lg file does -- relocates the current namespace permanently, and one
;; C-c C-e would otherwise cost you every alias above for the rest of the
;; session. eval-buffer always restores the editor ns after the load.
;; C-x C-e / C-j then eval in that buffer's `(ns ...)` (CIDER-style) so
;; `@a` after a C-c C-e still sees `foo/a`, and restore afterwards so the
;; editor doesn't move. No ns form: eval in the current *ns*, so an
;; explicit `(in-ns 'foo)` still sticks. The *repl* buffer is the same.

(ns legmacs.modes.letgo
  (:require [string]
            [legmacs.buffer :as buf]
            [legmacs.buffers :as bufs]
            [legmacs.indent :as indent]
            [legmacs.keymap :as km :refer [defcommand]]
            [legmacs.modes :as modes]
            [legmacs.lisp-syntax :as ls]))

(def keymap (atom {}))

;; --- syntax highlighting -------------------------------------------------
;;
;; Scanned one line at a time, but with a carry (see legmacs.modes/
;; register-mode!'s :highlight-line): a string literal left open at end of
;; line hands `:string` to the next line, which colors itself as string
;; content up to the closing quote. That's the only construct in let-go
;; that crosses a line -- comments end at the newline and character
;; literals are a couple of characters -- so :string is the whole carry
;; vocabulary here. Paren *matching* below never had the limitation, since
;; it scans the whole buffer.

(def special-forms
  #{"def" "defn" "defn-" "defmacro" "defcommand" "defcommand!" "defmethod" "defmulti"
    "ns" "require" "import" "in-ns"
    "let" "let*" "letfn" "loop" "recur" "fn" "fn*" "do"
    "if" "if-let" "if-not" "when" "when-let" "when-not" "when-first" "cond" "cond->" "cond->>" "case"
    "and" "or" "not" "->" "->>" "as->" "some->" "some->>"
    "quote" "var" "throw" "try" "catch" "finally"
    "doseq" "dotimes" "while" "for"
    "atom" "deref" "swap!" "reset!"
    "true" "false" "nil"})

(defn- digit-char? [ch] (<= 48 (int ch) 57))

(defn- symbol-char? [ch]
  (let [c (int ch)]
    (or (<= 97 c 122) (<= 65 c 90) (<= 48 c 57)
        (contains? #{45 95 42 43 33 63 60 62 61 46 47 58 39} c))))

(defn- tokenize-words [line]
  (let [chars (vec (seq line)), n (count chars)]
    (loop [i 0, tokens []]
      (if (>= i n)
        tokens
        (let [ch (nth chars i)]
          (if (symbol-char? ch)
            (let [j (loop [j i] (if (and (< j n) (symbol-char? (nth chars j))) (recur (inc j)) j))]
              (recur j (conj tokens [i j (subs line i j)])))
            (recur (inc i) tokens)))))))

(defn- number-token?
  "Same coarse dispatch rule pkg/compiler/reader.go's Read() uses to decide
   a token is a number: starts with a digit, or +/- immediately followed by
   one -- e.g. -5 and 0x1F are numbers, but -foo and -> are symbols."
  [text]
  (and (pos? (count text))
       (let [c0 (nth text 0)]
         (or (digit-char? c0)
             (and (contains? #{\+ \-} c0) (> (count text) 1) (digit-char? (nth text 1)))))))

(defn- keyword-token?
  "A :foo or ::foo/bar keyword literal -- anything tokenize-words grouped
   together (since : is a symbol-char) that starts with a colon."
  [text]
  (and (> (count text) 1) (= \: (nth text 0))))

(defn- highlight-scanned
  "highlight-line's body, over an already-computed scan of `line` -- the
   carry-aware wrapper below needs the same scan for its own answer, and
   scanning twice per visible line per frame is the one cost worth avoiding
   here."
  [line scanned]
  (let [covered? (fn [pos] (some (fn [{:keys [start end]}] (and (<= start pos) (< pos end))) (:spans scanned)))
        span-highlights (map (fn [{:keys [type start end]}] {:style type :start start :end end}) (:spans scanned))
        words (tokenize-words line)
        ;; :spans now also covers character literals (legmacs.lisp-syntax/
        ;; scan tags \5, \newline, etc. as :char), so this one check keeps
        ;; a digit or colon inside a char literal from also being read as
        ;; a number/keyword token.
        plain? (fn [s] (not (covered? s)))
        keyword-highlights (->> words
                                 (filter (fn [[s _e text]] (and (contains? special-forms text) (plain? s))))
                                 (map (fn [[s e _text]] {:style :keyword :start s :end e})))
        number-highlights (->> words
                                (filter (fn [[s _e text]] (and (number-token? text) (plain? s))))
                                (map (fn [[s e _text]] {:style :number :start s :end e})))
        keyword-literal-highlights (->> words
                                         (filter (fn [[s _e text]] (and (keyword-token? text) (plain? s))))
                                         (map (fn [[s e _text]] {:style :keyword-literal :start s :end e})))]
    (concat span-highlights keyword-highlights number-highlights keyword-literal-highlights)))

(defn highlight-line
  "Syntax spans for one line read on its own (no carry) -- the plain
   :highlighter view, still what most callers and the tests want."
  [line]
  (highlight-scanned line (ls/scan line)))

(defn- shift-spans [spans k]
  (mapv (fn [sp] (assoc sp :start (+ k (:start sp)) :end (+ k (:end sp)))) spans))

(defn- string-close
  "Index just past the quote that closes a string carried in from the
   previous line, or nil if this line doesn't close it. Backslash escapes
   count, so an escaped quote doesn't end the string."
  [line]
  (let [chars (vec (seq line)), n (count chars)]
    (loop [j 0]
      (cond
        (>= j n) nil
        (= \\ (nth chars j)) (recur (+ j 2))
        (= \" (nth chars j)) (inc j)
        :else (recur (inc j))))))

(defn highlight-line-carry
  "The :highlight-line form of the above: `carry` is :string when the
   previous line ended inside an unterminated string literal, nil
   otherwise. A carried string colors from column 0 to its closing quote,
   and the rest of the line is then highlighted as ordinary code."
  [carry line]
  (if carry
    (if-let [end (string-close line)]
      (let [rest-line (subs line end)
            scanned (ls/scan rest-line)]
        {:spans (concat [{:style :string :start 0 :end end}]
                        (shift-spans (highlight-scanned rest-line scanned) end))
         :carry (when (:in-string? scanned) :string)})
      {:spans [{:style :string :start 0 :end (count line)}] :carry :string})
    (let [scanned (ls/scan line)]
      {:spans (highlight-scanned line scanned)
       :carry (when (:in-string? scanned) :string)})))

(defn highlight-carry
  "The cheap :highlight-carry half, run over every line above the viewport
   on every frame. A line with no quote on it can neither open nor close a
   string, so it hands the carry straight through after one (native)
   substring search; anything else goes to legmacs.lisp-syntax/
   ends-in-string?, which answers the same question a full scan would
   without building the spans and bracket tables nobody is going to look
   at here."
  [carry line]
  (if (string/includes? line "\"")
    (when (ls/ends-in-string? line (boolean carry)) :string)
    carry))

;; --- paren matching --------------------------------------------------
;;
;; Full-buffer-aware (unlike the per-line highlighter above), since a
;; matched bracket routinely spans many lines. Runs as :after-command, so
;; it stays current after every edit or cursor move while let-go-mode is
;; active -- see legmacs.modes/register-mode!.

(defn- char-at [chars offset]
  (when (< -1 offset (count chars)) (nth chars offset)))

(defn update-paren-match
  "Emacs show-paren-mode's rule: if the character *after* point is an
   open bracket, or the character *before* point is a close bracket,
   highlight it and its match. Otherwise clear :paren-match."
  [state]
  (let [chars (buf/buffer-chars state)
        offset (buf/offset-of state (:cursor-row state) (:cursor-col state))
        after (char-at chars offset)
        before (char-at chars (dec offset))
        point (cond
                (and after (ls/open-bracket? after)) offset
                (and before (ls/close-bracket? before)) (dec offset)
                :else nil)
        ;; a closer's match is the innermost bracket open in front of it,
        ;; which costs one lean pass up to point; only the open-bracket case
        ;; needs the full scan (and its bracket-pair map) to look forward
        match (when point
                (if (ls/close-bracket? (char-at chars point))
                  (ls/match-for-closer chars point)
                  (ls/matching (ls/scan chars) point)))]
    (assoc state :paren-match
           (when match
             [(buf/row-col-of state point) (buf/row-col-of state match)]))))

;; --- auto-pairing brackets ----------------------------------------------
;;
;; Emacs electric-pair-mode's core behavior, scoped to (), [], {}: typing an
;; opener inserts its closer too, cursor between them; typing a closer that
;; already sits right under the cursor just moves over it instead of
;; inserting a second one; backspacing between an empty pair (`(|)`) deletes
;; both sides at once. All three stand down inside a string or comment so
;; pairing doesn't kick in while typing literal punctuation inside
;; string/comment text.
;;
;; Deliberately *not* legmacs.lisp-syntax/in-string-or-comment? on a full
;; scan: that answers "does an already-typed character at this offset fall
;; inside a string/comment," using a half-open span (:end exclusive) --
;; correct for update-paren-match's already-typed brackets, but wrong for
;; *point itself* sitting at the end of an in-progress string, e.g. right
;; after typing the opening `"` of `"|`: point's offset there equals the
;; span's own (still-open) :end, which the exclusive check reads as
;; "just past it," not "inside it." legmacs.lisp-syntax/scan's :in-string?
;; (scanning only up to point) exists for exactly this question; comments
;; don't share the ambiguity (nothing "closes" a comment early the way a
;; closing quote does), so a plain end-of-span check suffices for those.

(def ^:private open->close-char {\( \) \[ \] \{ \}})

(defn- point-in-string-or-comment? [chars offset]
  (ls/point-in-string-or-comment-at? chars offset))

(defn- point-info [state]
  (let [chars (buf/buffer-chars state)
        offset (buf/offset-of state (:cursor-row state) (:cursor-col state))]
    {:before (char-at chars (dec offset))
     :after (char-at chars offset)
     :in-str-or-comment? (point-in-string-or-comment? chars offset)}))

(defn- insert-pair [state open-ch close-ch]
  (if (:in-str-or-comment? (point-info state))
    (buf/insert-string state (str open-ch))
    (-> state
        (buf/insert-string (str open-ch close-ch))
        (update :cursor-col dec))))

(defcommand auto-insert-paren
  "\"(\" in let-go-mode: insert \"()\" with point between them, unless
   point is inside a string or comment."
  [state] (insert-pair state \( \)))

(defcommand auto-insert-bracket
  "\"[\" in let-go-mode: insert \"[]\" with point between them, unless
   point is inside a string or comment."
  [state] (insert-pair state \[ \]))

(defcommand auto-insert-brace
  "\"{\" in let-go-mode: insert \"{}\" with point between them, unless
   point is inside a string or comment."
  [state] (insert-pair state \{ \}))

(defn- skip-or-insert-close [state close-ch]
  (let [{:keys [after in-str-or-comment?]} (point-info state)]
    (if (and (not in-str-or-comment?) (= after close-ch))
      (buf/move-right state)
      (buf/insert-string state (str close-ch)))))

(defcommand auto-close-paren
  "\")\" in let-go-mode: move over a following \")\" rather than inserting
   a second one, unless point is inside a string or comment."
  [state] (skip-or-insert-close state \)))

(defcommand auto-close-bracket
  "\"]\" in let-go-mode: move over a following \"]\" rather than inserting
   a second one, unless point is inside a string or comment."
  [state] (skip-or-insert-close state \]))

(defcommand auto-close-brace
  "\"}\" in let-go-mode: move over a following \"}\" rather than inserting
   a second one, unless point is inside a string or comment."
  [state] (skip-or-insert-close state \}))

(defcommand auto-delete-pair
  "DEL in let-go-mode: backspacing right between an empty auto-inserted
   pair (e.g. \"(|)\") deletes both characters; otherwise a normal
   backward delete."
  [state]
  (let [{:keys [before after in-str-or-comment?]} (point-info state)]
    (if (and before (not in-str-or-comment?) (= after (get open->close-char before)))
      (-> state buf/delete-char-forward buf/delete-char-backward)
      (buf/delete-char-backward state))))

(defn- format-result [v]
  (try (pr-str v) (catch e (str "#<unprintable " (ex-message e) ">"))))

(defn- capturing-out
  "Run `thunk` with *out* and *err* rebound to a capture buffer.

   The editor paints the TTY through *out* (term/write). A scratch
   (go (println ...)) inherits the caller's *out* via future*/go*
   snapshotting the spawning context -- without this, those bytes land
   on the alternate screen and the next frame never comes until a key.
   Spawned goroutines keep the capture handle after this returns; the
   editor's own term/write still uses the root stdout binding."
  [thunk]
  (let [result (atom nil)]
    (with-out-str
      (binding [*err* *out*]
        (reset! result (thunk))))
    @result))

(defn eval-form
  "eval `form` with *out*/*err* captured (see capturing-out)."
  [form]
  (capturing-out (fn [] (eval form))))

(defn- eval-each-form
  "eval every form in `forms` in the current *ns*, returning the last
   result. let-go's load-string compiles in clojure.core, which does not
   refer let-go.core, so lg-isms like `now` fail and defs intern into
   core -- that is the wrong home for *scratch* / C-c C-e / *repl*."
  [forms]
  (reduce (fn [_ form] (eval form)) nil forms))

(defn load-in-editor
  "Read `s` and eval each form in the current *ns*, with *out*/*err*
   captured (see capturing-out). The *repl* buffer uses this so a typed
   (go (println ...)) cannot clobber the frame either."
  [s]
  (capturing-out (fn [] (eval-each-form (read-all-string s)))))

(defn preserving-ns
  "Run `thunk`, then put the current namespace back where it was.

   Loading a file that opens with an `(ns ...)` form *switches the running
   namespace and never switches back* -- and since legmacs evaluates in its
   own live namespace, that would leave every alias the editor set up
   (`buf/`, `km/`, `dispatch/`, `render/`) unresolvable for the rest of the
   session: one C-c C-e on any ordinary .lg file and C-x C-e stops
   working. Emacs's load-file doesn't relocate you either.

   C-x C-e / C-j wrap this around an (in-ns buffer-ns) when the buffer
   has an ns form, so a def interned by eval-buffer is visible without
   leaving the editor stuck in that ns. No ns form: they eval in the
   current *ns*, and an explicit `(in-ns 'foo)` still moves you.

   Written the long way round because let-go's `finally` can't propagate an
   exception -- see CLAUDE.md."
  [thunk]
  (let [saved (ns-name *ns*)
        outcome (try {:ok (thunk)} (catch e {:err e}))]
    (in-ns saved)
    (if (contains? outcome :err) (throw (:err outcome)) (:ok outcome))))

(defn- ns-form-name
  "The namespace symbol in a `(ns ...)` form, or nil."
  [form]
  (when (and (seq? form) (= 'ns (first form)))
    (let [n (second form)]
      (cond
        (symbol? n) n
        (and (seq? n) (= 'with-meta (first n))) (second n)
        :else nil))))

(defn- buffer-ns-name
  "The name in the first top-level `(ns ...)` form, or nil if the buffer
   has none (or can't be read)."
  [state]
  (try
    (loop [forms (seq (read-all-string (buf/buffer-text state)))]
      (when forms
        (or (ns-form-name (first forms))
            (recur (next forms)))))
    (catch e
      (try (ns-form-name (read-string (buf/buffer-text state)))
           (catch e2 nil)))))

(defn- eval-form-in-ns
  "eval `form` after (in-ns ns-sym), then restore the editor ns.
   Own named fn so eval-form-in-state's if-let contains a call, not a
   capturing fn literal (let-go AOT hoist, nooga/let-go#766)."
  [ns-sym form]
  (preserving-ns (fn [] (in-ns ns-sym) (eval-form form))))

(defn- eval-form-in-state
  "eval `form` in the buffer's ns when it has an ns form, then restore
   the editor ns. Without an ns form, eval in whatever *ns* is now."
  [state form]
  (if-let [ns-sym (buffer-ns-name state)]
    (eval-form-in-ns ns-sym form)
    (eval-form form)))

;; --- form discovery and evaluation --------------------------------------
;;
;; Eval commands share one structural answer to "what is at point?": an
;; active region, otherwise the innermost bracketed form containing point
;; (or ending immediately before it), otherwise a string/character/token.
;; This is deliberately offset-based. Besides making point placement much
;; less fussy than read-all-string over the prefix, the same span can be
;; painted while an asynchronous evaluator (vibe today, nREPL later) runs.

(def ^:dynamic *eval-replace-context*
  "Bound while C-c C-v evaluates a form for replacement. Ordinary functions
   can ignore it. A function such as vibe may use the buffer snapshot and
   return replacement-result so it can customize how its value is spliced."
  nil)

(def eval-result-handlers
  "Extensible result-kind -> (fn [state start end result-map] -> state).
   This keeps the evaluator independent of vibe and leaves the same seam for
   later remote/nREPL result handling."
  (atom {}))

(defn register-eval-result-handler!
  "Register the main-thread splice handler for tagged eval results of `kind`."
  [kind handler]
  (swap! eval-result-handlers assoc kind handler)
  kind)

(defn replacement-result
  "A value an evaluated function can return under *eval-replace-context* to
   request source-aware replacement instead of ordinary pr-str formatting."
  [kind text]
  {:legmacs.eval/kind kind :legmacs.eval/text text})

(defn- replacement-result? [v]
  (and (map? v) (contains? v :legmacs.eval/kind) (contains? v :legmacs.eval/text)))

(defn- selection-region-offsets [state]
  (when-let [[[sr sc] [er ec]] (buf/region-bounds state)]
    [(buf/offset-of state sr sc) (buf/offset-of state er ec)]))

(defn- pair-span-at [chars scanned point]
  (let [pairs (filter (fn [[o c]]
                        (and (< o c) (<= o point) (<= point (inc c))))
                      (:pairs scanned))]
    (when (seq pairs)
      (let [[o c] (apply max-key first pairs)
            ;; Reader prefixes belong to the form: '(x), @(f), #(x), ~@x.
            start (loop [s o]
                    (if (and (pos? s)
                             (contains? #{\' \@ \` \~ \#} (nth chars (dec s))))
                      (recur (dec s))
                      s))]
        [start (inc c)]))))

(defn- literal-span-at [scanned point]
  (let [spans (filter (fn [{:keys [type start end]}]
                        (and (not= :comment type)
                             (<= start point) (<= point end)))
                      (:spans scanned))]
    (when (seq spans)
      (let [{:keys [start end]} (apply max-key :start spans)] [start end]))))

(defn- token-delimiter? [ch]
  (or (nil? ch)
      (contains? #{\space \tab \newline \return \, \( \) \[ \] \{ \} \" \;} ch)))

(defn- token-span-at [chars scanned point]
  (let [n (count chars)
        anchor (cond
                 (and (< point n) (not (token-delimiter? (nth chars point)))) point
                 (and (pos? point) (not (token-delimiter? (nth chars (dec point))))) (dec point)
                 :else nil)]
    (when (and anchor (not (ls/in-string-or-comment? scanned anchor)))
      (let [start (loop [i anchor]
                    (if (and (pos? i) (not (token-delimiter? (nth chars (dec i)))))
                      (recur (dec i)) i))
            end (loop [i (inc anchor)]
                  (if (and (< i n) (not (token-delimiter? (nth chars i))))
                    (recur (inc i)) i))]
        [start end]))))

(defn form-span-at-point
  "[start end) for the region or readable form at/around point. Public so a
   future evaluator backend can reuse exactly the local evaluator's DWIM
   selection semantics."
  [state]
  (or (selection-region-offsets state)
      (let [chars (buf/buffer-chars state)
            point (buf/offset-of state (:cursor-row state) (:cursor-col state))
            scanned (ls/scan chars)]
        (or (pair-span-at chars scanned point)
            (literal-span-at scanned point)
            (token-span-at chars scanned point)))))

(defn- eval-selection [state]
  (if-let [[start end] (form-span-at-point state)]
    (let [text (buf/buffer-text state)
          source (subs text start end)]
      (try (let [forms (vec (read-all-string source))]
             (if (seq forms)
               [:ok start end source forms]
               [:none nil nil nil nil]))
           (catch e [:error start end source (or (ex-message e) (str e))])))
    [:none nil nil nil nil]))

(defn- highlight-span [state start end sticky?]
  (assoc state :eval-highlight {:start start :end end :sticky? sticky?}))

(defn- clear-highlight [state highlight]
  (if (= highlight (:eval-highlight state)) (dissoc state :eval-highlight) state))

(defn- run-eval [state f]
  (let [[status start end _source forms] (eval-selection state)]
    (case status
      :none (assoc state :message "No preceding sexp")
      :error (assoc state :message (str "Read error: " forms))
      (try
        (f (highlight-span state start end false)
           start end forms
           (reduce (fn [_ form] (eval-form-in-state state form)) nil forms))
        (catch e (-> state
                     (highlight-span start end false)
                     (assoc :message (str "Eval error: " (or (ex-message e) (str e))))))))))

(defcommand eval-last-sexp
  "Evaluate the s-expression immediately before point; show the result in
   the echo area, like Emacs's C-x C-e."
  [state]
  (run-eval state (fn [state _start _end _form result]
                     (assoc state :message (str "=> " (format-result result))))))

(defcommand eval-print-last-sexp
  "Evaluate the s-expression immediately before point and insert the
   result right after it, like Emacs's C-j in lisp-interaction-mode --
   this is what makes *scratch* feel like a REPL transcript."
  [state]
  (run-eval state (fn [state _start end _form result]
                     (let [[row col] (buf/row-col-of state end)]
                       (buf/insert-string (assoc state :cursor-row row :cursor-col col)
                                          (str "\n" (format-result result)))))))

(defn- splice-offsets
  "Replace a flat [start end) span with text as one undo step."
  [state start end replacement]
  (if-not (buf/writable? state)
    (assoc state :message "Buffer is read-only")
    (let [text (buf/buffer-text state)
          new-text (str (subs text 0 start) replacement (subs text end))
          state (-> (buf/push-undo state)
                    (assoc :lines (buf/split-lines new-text) :modified? true))
          [row col] (buf/row-col-of state (+ start (count replacement)))]
      (-> state
          (assoc :cursor-row row :cursor-col col :goal-col nil)
          buf/clamp-cursor))))

(defn- apply-source-result [state start end result]
  (-> (splice-offsets state start end (:legmacs.eval/text result))
      (assoc :message "Evaluated and replaced")))

(register-eval-result-handler! :source apply-source-result)

(defn- apply-replacement-result [state start end result]
  (if (replacement-result? result)
    (if-let [handler (get @eval-result-handlers (:legmacs.eval/kind result))]
      (handler state start end result)
      (assoc state :message (str "No eval result handler for " (:legmacs.eval/kind result))))
    (-> (splice-offsets state start end (format-result result))
        (assoc :message "Evaluated and replaced"))))

(defn- in-process-eval-backend
  "The built-in evaluator backend. A future nREPL backend receives the same
   request map but can use :source/:namespace without touching editor state."
  [{:keys [state forms context]}]
  (binding [*eval-replace-context* context]
    (reduce (fn [_ form] (eval-form-in-state state form)) nil forms)))

(def eval-backends
  "Registered eval backend functions, each (fn [request-map] -> value).
   Backends run inside the generic async job and must not mutate buffers."
  (atom {:in-process in-process-eval-backend}))

(def current-eval-backend
  "The backend used by C-c C-v. Kept as data so an nREPL client can install
   and select itself without replacing the command or key binding."
  (atom :in-process))

(defn register-eval-backend!
  "Register an async-safe evaluator function under `name`."
  [name evaluator]
  (swap! eval-backends assoc name evaluator)
  name)

(defn use-eval-backend!
  "Select a registered evaluator backend. Returns name, or nil if unknown."
  [name]
  (when (contains? @eval-backends name)
    (reset! current-eval-backend name)))

(defn- eval-replace-value [request]
  (if-let [backend (get @eval-backends @current-eval-backend)]
    (backend request)
    (throw (str "Unknown eval backend " (pr-str @current-eval-backend)))))

(defn- eval-replace-io [request]
  (fn [] (eval-replace-value request)))

(defn- resolve-eval-replace [state start end source highlight outcome]
  (let [state (clear-highlight state highlight)]
    (if-let [err (:err outcome)]
      (assoc state :message (str "Eval error: " (or (ex-message err) (str err))))
      (let [text (buf/buffer-text state)]
        (if-not (and (<= end (count text)) (= source (subs text start end)))
          (assoc state :message "Eval: form moved before it completed")
          (apply-replacement-result state start end (:ok outcome)))))))

(defn- eval-replace-then [start end source highlight]
  (fn [state outcome] (resolve-eval-replace state start end source highlight outcome)))

(defcommand eval-replace-sexp
  "Evaluate the region or s-expression at point asynchronously and replace
   it with the printed result. C-c C-v is intentionally universal: vibe is
   one ordinary function using the tagged-result extension, not a special
   case in this command."
  [state]
  (if-not (buf/writable? state)
    (assoc state :message "Buffer is read-only")
    (let [[status start end source forms] (eval-selection state)]
      (case status
        :none (assoc state :message "No s-expression at point")
        :error (assoc state :message (str "Read error: " forms))
        (let [text (buf/buffer-text state)
              [_row column] (buf/row-col-of state start)
              context {:text text :source source :start start :end end
                       :filename (:filename state) :column column
                       :namespace (buffer-ns-name state)}
              request {:state state :forms forms :source source :context context}
              highlight {:start start :end end :sticky? true}
              state (assoc state :eval-highlight highlight)]
          (bufs/spawn-task state
                           (eval-replace-io request)
                           (eval-replace-then start end source highlight)
                           "evaluating..."))))))

(defcommand eval-buffer
  "Evaluate the entire buffer, top to bottom, form by form in the current
   namespace (or the buffer's ns form, restored afterwards)."
  [state]
  (try
    (let [result (preserving-ns (fn [] (load-in-editor (buf/buffer-text state))))]
      (assoc state :message (str "=> " (format-result result))))
    (catch e (assoc state :message (str "Eval error: " (or (ex-message e) (str e)))))))

;; --- auto-indent --------------------------------------------------------
;;
;; Lisp doesn't indent by nesting depth, it indents by *where the enclosing
;; form starts*: a continuation line lines up under that form's first
;; argument, so a multi-line call reads as one call. The exception is forms
;; with a body rather than an argument list (defn, let, when, try, ...),
;; whose body is a fixed two columns in from the bracket. That's the whole
;; rule below, and it's why let-go-mode doesn't use legmacs.indent's
;; spec-driven rules (which model bracket depth and keyword blocks -- two
;; things Lisp doesn't have): the shape of the answer is genuinely
;; different. It shares legmacs.indent's *edit* half, though, so TAB
;; behaves identically here and in a Go buffer.

(def indent-width
  "Columns a body form's body is indented past its opening bracket."
  2)

(def ^:private body-form-prefixes ["def" "with-" "when-" "if-"])

(defn- body-form?
  "Does a form headed by `head` indent its body a flat indent-width, rather
   than aligning under its first argument? True for the special forms, for
   anything def-ish, and for the with-/when-/if- families a macro author
   conventionally gives a body to."
  [head]
  (boolean
   (or (contains? special-forms head)
       (contains? #{"testing" "binding" "condp" "doto" "future" "delay" "comment"} head)
       (some (fn [p] (string/starts-with? head p)) body-form-prefixes))))

(def ^:private token-stop?
  #{\( \) \[ \] \{ \} \" \; \space \tab \,})

(defn- token-at
  "[start end] of the token beginning at or after column `col` of `line`,
   or nil if the rest of the line is blank (or only a comment)."
  [line col]
  (let [chars (vec (seq line))
        n (count chars)
        start (loop [i col]
                (if (and (< i n) (contains? #{\space \tab \,} (nth chars i))) (recur (inc i)) i))]
    (when (and (< start n) (not= \; (nth chars start)))
      [start (loop [i start]
               (if (and (< i n) (not (contains? token-stop? (nth chars i)))) (recur (inc i)) i))])))

(defn indent-column-for
  "The column line `row` should start at: aligned to the innermost form
   still open above it. A `[` or `{` literal aligns one past the bracket, a
   body form indents indent-width past it, and anything else aligns under
   the first argument on the opener's own line (falling back to one past
   the bracket when the opener ends its line)."
  [state row]
  (let [chars (buf/buffer-chars state)
        offset (buf/offset-of state row 0)]
    (if-let [[open-ch open-offset] (ls/innermost-open-before chars offset)]
      (let [[open-row open-col] (buf/row-col-of state open-offset)
            line (nth (:lines state) open-row)]
        (if (contains? #{\[ \{} open-ch)
          (inc open-col)
          (if-let [[head-start head-end] (token-at line (inc open-col))]
            (if (body-form? (subs line head-start head-end))
              (+ open-col indent-width)
              (if-let [[arg-start _] (token-at line head-end)]
                arg-start
                (+ open-col indent-width)))
            (inc open-col))))
      0)))

(defcommand newline-and-indent
  "RET in let-go-mode: open a new line, indented to line up with the form
   it sits inside (see indent-column-for)."
  [state]
  (let [row (:cursor-row state)
        state (buf/insert-newline state)
        new-row (inc row)
        col (indent-column-for state new-row)]
    (-> (indent/set-line-indent state new-row col)
        (assoc :cursor-row new-row :cursor-col col))))

(defcommand lisp-indent-line
  "TAB in let-go-mode: re-indent the current line to line up with the form
   it's inside, moving point to the first non-blank character if it was in
   the leading whitespace."
  [state]
  (indent/set-line-indent state (:cursor-row state) (indent-column-for state (:cursor-row state))))

;; --- expand-region / contract-region -------------------------------------
;;
;; Structural selection: grow the region outward one syntactic unit at a
;; time -- the word at point, then its innermost enclosing sexp (brackets
;; included), then the next sexp up, and so on -- using the same paren-pair
;; map paren-matching is built on. Each step is pushed onto :expand-stack
;; so contract-region can shrink back to exactly where it was, the same way
;; the real expand-region package works.
;;
;; Known simplification: :expand-stack isn't reset by other commands, so
;; interleaving expand-region with unrelated edits/motions and then
;; contracting can restore a stale-looking region. Harmless, just a little
;; surprising -- not worth the bookkeeping to fix for v1.

(defn- pair->region [[o c]] [o (inc c)])

(defn- region-offsets [state]
  (when-let [[[sr sc] [er ec]] (buf/region-bounds state)]
    [(buf/offset-of state sr sc) (buf/offset-of state er ec)]))

(defn- set-region-from-offsets [state start end]
  (let [[msr msc] (buf/row-col-of state start)
        [csr csc] (buf/row-col-of state end)]
    (assoc state :mark [msr msc] :cursor-row csr :cursor-col csc)))

(defn- word-region-at-point [state]
  (when-let [[[sr sc] [er ec]] (buf/symbol-bounds-at state)]
    [(buf/offset-of state sr sc) (buf/offset-of state er ec)]))

(defn- next-region-to-select [state]
  (let [scanned (ls/scan (buf/buffer-chars state))
        current (region-offsets state)]
    (if current
      (let [[s e] current]
        (when-let [pair (ls/enclosing-pair scanned s e)] (pair->region pair)))
      (or (word-region-at-point state)
          (let [point (buf/offset-of state (:cursor-row state) (:cursor-col state))]
            (when-let [pair (ls/innermost-pair-containing scanned point)] (pair->region pair)))))))

(defcommand expand-region
  "Grow the selection outward by one syntactic unit."
  [state]
  (if-let [[s e] (next-region-to-select state)]
    (-> state
        (update :expand-stack conj (region-offsets state))
        (set-region-from-offsets s e))
    (assoc state :message "Nothing more to select")))

(defcommand contract-region
  "Undo the last expand-region step."
  [state]
  (if (seq (:expand-stack state))
    (let [prev (first (:expand-stack state))
          state (update state :expand-stack rest)]
      (if prev
        (apply set-region-from-offsets state prev)
        (assoc state :mark nil)))
    (assoc state :message "Nothing to contract")))

(km/bind-key! keymap "C-x C-e" :eval-last-sexp)
(km/bind-key! keymap "C-j" :eval-print-last-sexp)
(km/bind-key! keymap "C-c C-v" :eval-replace-sexp)
(km/bind-key! keymap "C-c C-e" :eval-buffer)
(km/bind-key! keymap "RET" :newline-and-indent)
(km/bind-key! keymap "TAB" :lisp-indent-line)
(km/bind-key! keymap "C-c e" :expand-region)
(km/bind-key! keymap "C-c u" :contract-region)
(km/bind-key! keymap "(" :auto-insert-paren)
(km/bind-key! keymap "[" :auto-insert-bracket)
(km/bind-key! keymap "{" :auto-insert-brace)
(km/bind-key! keymap ")" :auto-close-paren)
(km/bind-key! keymap "]" :auto-close-bracket)
(km/bind-key! keymap "}" :auto-close-brace)
(km/bind-key! keymap "DEL" :auto-delete-pair)

(modes/register-mode! :let-go keymap
                       (str "let-go-mode: C-x C-e eval-last-sexp, C-j eval-print-last-sexp, "
                            "C-c C-v eval-and-replace, "
                            "C-c C-e eval-buffer, RET auto-indents, C-c e/u expand/contract-region")
                       {:highlighter highlight-line
                        :highlight-line highlight-line-carry
                        :highlight-carry highlight-carry
                        :after-command update-paren-match})
(modes/register-auto-mode! ".lg" :let-go)
;; let-go is a Clojure dialect, and shares its reader syntax closely enough
;; (parens/brackets/braces, `;` line comments, `"`-delimited strings) that
;; real Clojure/ClojureScript/ClojureCommon/Babashka source and EDN data
;; files get correct highlighting, paren-matching, auto-pairing, and
;; auto-indent from let-go-mode as-is -- eval (C-x C-e etc.) will of course
;; only succeed on forms that are also valid let-go.
(doseq [suffix [".clj" ".cljc" ".cljs" ".bb" ".edn"]]
  (modes/register-auto-mode! suffix :let-go))
