(ns test.buffers-test
  (:require [test :refer :all]
            [string]
            [legmacs.buffer :as buf]
            [legmacs.buffers :as bufs]))

(deftest new-workspace-has-one-current-buffer
  (testing "starts with exactly the given buffer as id 0, current"
    (let [ws (bufs/new-workspace (buf/new-state "a.txt" ["hi"]))]
      (is (= 0 (:current ws)))
      (is (= [0] (:order ws)))
      (is (= ["hi"] (:lines (bufs/current ws)))))))

(deftest current-merges-shared-fields-and-metadata
  (testing "the flat view carries filename/lines from the buffer plus shared/global fields"
    (let [ws (assoc (bufs/new-workspace (buf/new-state "a.txt" ["hi"])) :message "hello" :clipboard "clip")
          flat (bufs/current ws)]
      (is (= "a.txt" (:filename flat)))
      (is (= "hello" (:message flat)))
      (is (= "clip" (:clipboard flat)))
      (is (= 0 (:current-buffer-id flat)))
      (is (= [{:id 0 :name "a.txt" :filename "a.txt" :modified? false :mode nil}] (:buffer-list flat))))))

(deftest put-current-round-trips-edits
  (testing "editing the flat view and folding it back updates the stored buffer"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          edited (assoc (bufs/current ws) :lines ["x" "y"] :cursor-row 1)
          ws (bufs/put-current ws edited)]
      (is (= ["x" "y"] (:lines (bufs/current ws))))
      (is (= 1 (:cursor-row (bufs/current ws)))))))

(deftest shared-fields-persist-across-a-buffer-switch
  (testing "clipboard/message set in one buffer are still there after switching to another"
    (let [ws (bufs/new-workspace (buf/new-state nil ["a"]))
          ws (bufs/put-current ws (assoc (bufs/current ws) :clipboard "killed text" :message "note"))
          ws (bufs/put-current ws (assoc (bufs/current ws)
                                          :buffer-command {:op :open-new :state (buf/new-state nil ["b"])}))
          flat (bufs/current ws)]
      (is (= ["b"] (:lines flat)))
      (is (= "killed text" (:clipboard flat)))
      (is (= "note" (:message flat))))))

(deftest open-new-buffer-command
  (testing "creates a new buffer, appends it to :order, and switches to it"
    (let [ws (bufs/new-workspace (buf/new-state nil ["a"]))
          ws (bufs/put-current ws (assoc (bufs/current ws)
                                          :buffer-command {:op :open-new :state (buf/new-state "b.txt" ["b"])}))]
      (is (= [0 1] (:order ws)))
      (is (= 1 (:current ws)))
      (is (= ["b"] (:lines (bufs/current ws))))
      ;; the buffer left behind is untouched, still reachable
      (is (= ["a"] (:lines (get-in ws [:buffers 0])))))))

(deftest switch-buffer-command
  (testing "switches :current without touching either buffer's content"
    (let [ws (bufs/new-workspace (buf/new-state nil ["a"]))
          ws (bufs/put-current ws (assoc (bufs/current ws)
                                          :buffer-command {:op :open-new :state (buf/new-state nil ["b"])}))
          ws (bufs/put-current ws (assoc (bufs/current ws) :buffer-command {:op :switch :id 0}))]
      (is (= 0 (:current ws)))
      (is (= ["a"] (:lines (bufs/current ws)))))))

(deftest next-and-previous-buffer-cycle-with-wraparound
  (testing "next/prev walk :order and wrap around at the ends"
    (let [ws (bufs/new-workspace (buf/new-state nil ["a"]))
          ws (bufs/put-current ws (assoc (bufs/current ws) :buffer-command {:op :open-new :state (buf/new-state nil ["b"])}))
          ws (bufs/put-current ws (assoc (bufs/current ws) :buffer-command {:op :open-new :state (buf/new-state nil ["c"])}))]
      ;; order is [0 1 2], current is 2
      (let [ws2 (bufs/put-current ws (assoc (bufs/current ws) :buffer-command {:op :next}))]
        (is (= 0 (:current ws2))) ;; wraps around
        (let [ws3 (bufs/put-current ws2 (assoc (bufs/current ws2) :buffer-command {:op :prev}))]
          (is (= 2 (:current ws3)))))))) ;; wraps the other way

(deftest kill-buffer-command
  (testing "killing a non-current buffer leaves current alone"
    (let [ws (bufs/new-workspace (buf/new-state nil ["a"]))
          ws (bufs/put-current ws (assoc (bufs/current ws) :buffer-command {:op :open-new :state (buf/new-state nil ["b"])}))
          ws (bufs/put-current ws (assoc (bufs/current ws) :buffer-command {:op :kill :id 0}))]
      (is (= [1] (:order ws)))
      (is (= 1 (:current ws)))))

  (testing "killing the current buffer falls back to another existing one"
    (let [ws (bufs/new-workspace (buf/new-state nil ["a"]))
          ws (bufs/put-current ws (assoc (bufs/current ws) :buffer-command {:op :open-new :state (buf/new-state nil ["b"])}))
          ws (bufs/put-current ws (assoc (bufs/current ws) :buffer-command {:op :kill :id 1}))]
      (is (= [0] (:order ws)))
      (is (= 0 (:current ws)))))

  (testing "killing the only buffer falls back to the supplied fresh buffer, never leaving zero"
    (let [ws (bufs/new-workspace (buf/new-state nil ["only"]))
          ws (bufs/put-current ws (assoc (bufs/current ws)
                                          :buffer-command {:op :kill :id 0 :fallback (buf/new-state nil ["fresh"])}))]
      (is (= 1 (count (:order ws))))
      (is (= ["fresh"] (:lines (bufs/current ws)))))))

(deftest buffer-list-deduplicates-names-like-emacs
  (testing "the first buffer with a given base name keeps it; later ones get <2>, <3>, ..."
    (let [ws (bufs/new-workspace (buf/new-state nil ["a"]))
          ws (bufs/put-current ws (assoc (bufs/current ws) :buffer-command {:op :open-new :state (buf/new-state nil ["b"])}))
          ws (bufs/put-current ws (assoc (bufs/current ws) :buffer-command {:op :open-new :state (buf/new-state nil ["c"])}))]
      (is (= ["*scratch*" "*scratch*<2>" "*scratch*<3>"] (map :name (bufs/buffer-list ws)))))))

(deftest buffer-names-are-basenames-not-full-paths
  (testing "a buffer's display name is the last path segment, like Emacs, not the full path"
    (let [ws (bufs/new-workspace (buf/new-state "/some/deep/dir/a.txt" ["x"]))]
      (is (= "a.txt" (:name (first (bufs/buffer-list ws)))))))

  (testing "two files with the same basename in different directories still get deduplicated, not merged"
    (let [ws (bufs/new-workspace (buf/new-state "/dir1/a.txt" ["x"]))
          ws (bufs/put-current ws (assoc (bufs/current ws)
                                          :buffer-command {:op :open-new :state (buf/new-state "/dir2/a.txt" ["y"])}))]
      (is (= ["a.txt" "a.txt<2>"] (map :name (bufs/buffer-list ws))))
      ;; :filename stays the real, full path -- only :name is shortened
      (is (= ["/dir1/a.txt" "/dir2/a.txt"] (map :filename (bufs/buffer-list ws)))))))

(deftest quit-flag-flows-through-put-current
  (testing "a command setting :quit? true on the flat state surfaces on the workspace"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          ws (bufs/put-current ws (assoc (bufs/current ws) :quit? true))]
      (is (:quit? ws)))))

;; --- windows through the same put-current fold --------------------------

(defn- send [ws cmd] (bufs/put-current ws (assoc (bufs/current ws) :buffer-command cmd)))

(deftest append-named-creates-reuses-and-accumulates-output
  (let [first-state (assoc (buf/new-state nil ["; pwd" "/tmp"])
                           :buffer-name "/tmp/+Errors")
        second-state (assoc (buf/new-state nil ["; echo hi" "hi"])
                            :buffer-name "/tmp/+Errors")
        ws (bufs/new-workspace (buf/new-state nil ["source"]))
        ws (send ws {:op :append-named :name "/tmp/+Errors" :state first-state})
        output-id (:current ws)
        ws (send ws {:op :append-named :name "/tmp/+Errors" :state second-state})]
    (is (= output-id (:current ws)))
    (is (= 2 (count (:order ws))))
    (is (= ["; pwd" "/tmp" "" "; echo hi" "hi"]
           (:lines (bufs/current ws))))
    (is (= 4 (:cursor-row (bufs/current ws))))
    (is (= 2 (:cursor-col (bufs/current ws))))))

(deftest split-adds-a-window-on-the-same-buffer
  (testing "C-x 2's op leaves focus in the original window, both showing the buffer"
    (let [ws (bufs/new-workspace (buf/new-state "a.txt" ["one" "two"]))
          ws (send ws {:op :split :dir :below})]
      (is (= 2 (:window-count (bufs/current ws))))
      (is (= 0 (:active-window ws)))
      (is (= ["one" "two"] (:lines (bufs/flat-for-window ws 1)))))))

(deftest window-views-diverge-after-a-split
  (testing "moving point in one window doesn't move it in the other"
    (let [ws (bufs/new-workspace (buf/new-state nil ["a" "b" "c"]))
          ws (send ws {:op :split :dir :beside})
          ws (bufs/put-current ws (assoc (bufs/current ws) :cursor-row 2))]
      (is (= 2 (:cursor-row (bufs/current ws))))
      (let [ws (send ws {:op :other-window})]
        (is (= 1 (:active-window ws)))
        (is (= 0 (:cursor-row (bufs/current ws))))
        ;; ...and the first window still remembers row 2
        (is (= 2 (:cursor-row (bufs/flat-for-window ws 0))))))))

(deftest other-window-cycles-and-tracks-current-buffer
  (testing "switching windows retargets :current at that window's buffer"
    (let [ws (bufs/new-workspace (buf/new-state nil ["a"]))
          ws (send ws {:op :split :dir :below})
          ws (send ws {:op :other-window})
          ws (send ws {:op :switch :id 0})  ;; no-op switch, still buffer 0
          ws (send ws {:op :open-new :state (buf/new-state nil ["b"])})]
      ;; window 1 (active) now shows the new buffer; window 0 kept buffer 0
      (is (= ["b"] (:lines (bufs/current ws))))
      (is (= ["a"] (:lines (bufs/flat-for-window ws 0))))
      (let [ws (send ws {:op :other-window})]
        (is (= 0 (:active-window ws)))
        (is (= 0 (:current ws)))
        (is (= ["a"] (:lines (bufs/current ws))))))))

(deftest delete-window-gives-way-to-the-next-one
  (let [ws (bufs/new-workspace (buf/new-state nil ["a"]))
        ws (send ws {:op :split :dir :below})
        ws (send ws {:op :delete-window})]
    (is (= 1 (:window-count (bufs/current ws))))
    (is (= 1 (:active-window ws)))
    (is (= ["a"] (:lines (bufs/current ws))))))

(deftest delete-window-refuses-to-remove-the-sole-window
  (let [ws (bufs/new-workspace (buf/new-state nil ["a"]))
        ws (send ws {:op :delete-window})]
    (is (= 1 (:window-count (bufs/current ws))))))

(deftest delete-other-windows-keeps-only-the-active-one
  (let [ws (bufs/new-workspace (buf/new-state nil ["a"]))
        ws (send ws {:op :split :dir :below})
        ws (send ws {:op :split :dir :beside})
        ws (send ws {:op :other-window})
        ws (send ws {:op :delete-other-windows})]
    (is (= 1 (:window-count (bufs/current ws))))
    (is (= ["a"] (:lines (bufs/current ws))))))

(deftest killing-a-buffer-repoints-every-window-showing-it
  (testing "two windows on the killed buffer both land on the replacement"
    (let [ws (bufs/new-workspace (buf/new-state nil ["keep"]))
          ws (send ws {:op :open-new :state (buf/new-state nil ["doomed"])})
          ws (send ws {:op :split :dir :below})   ;; both windows show buffer 1
          ws (send ws {:op :kill :id 1 :fallback (buf/new-state nil ["fresh"])})]
      (is (= 2 (:window-count (bufs/current ws))))
      (is (= ["keep"] (:lines (bufs/current ws))))
      (is (= ["keep"] (:lines (bufs/flat-for-window ws 1)))))))

(deftest switching-a-window-adopts-the-buffers-remembered-view
  (testing "a buffer re-shown in a window resumes at its stored cursor"
    (let [ws (bufs/new-workspace (buf/new-state nil ["a" "b" "c"]))
          ws (bufs/put-current ws (assoc (bufs/current ws) :cursor-row 2))
          ws (send ws {:op :open-new :state (buf/new-state nil ["other"])})
          ws (send ws {:op :switch :id 0})]
      (is (= 2 (:cursor-row (bufs/current ws)))))))

(deftest clearing-a-shared-field-by-dissoc-actually-clears-it
  (testing "dissoc-ing a shared key (not just assoc-ing it to nil) still clears it on the workspace
            -- this is exactly what dispatch does to dismiss an overlay"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          ws (bufs/put-current ws (assoc (bufs/current ws) :overlay {:title "t" :lines []}))]
      (is (some? (:overlay (bufs/current ws))))
      (let [ws (bufs/put-current ws (dissoc (bufs/current ws) :overlay))]
        (is (nil? (:overlay (bufs/current ws))))
        (is (nil? (:overlay ws)))))))

;; :pending-task -- the "let the screen catch up, then do the slow thing"
;; seam. main.lg's loop is the only production consumer, but the runner
;; lives in buffers so tests call the real thing (requiring main.lg would
;; start the editor -- see CLAUDE.md).

(deftest pending-task-is-a-shared-field-that-round-trips
  (testing "a command can arm a task; it lands on the workspace and in the flat view"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          task (fn [state] state)
          ws (bufs/put-current ws (bufs/arm-task (bufs/current ws) task "running ..."))]
      (is (fn? (:pending-task ws)))
      (is (fn? (:pending-task (bufs/current ws))))
      ;; the message is on the state that gets painted *before* the task runs
      (is (= "running ..." (:message (bufs/current ws))))))

  (testing "it is shared, not per-buffer: switching buffers doesn't lose it"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          ws (bufs/put-current ws (bufs/arm-task (bufs/current ws) (fn [state] state)))
          ws (send ws {:op :open-new :state (buf/new-state nil ["other"])})]
      (is (some? (:pending-task (bufs/current ws)))))))

(deftest running-a-pending-task-consumes-it-and-applies-its-state
  (testing "the task edits like any command, and does not run twice"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          appending (fn [state] (update state :lines conj "from the task"))
          ws (bufs/put-current ws (bufs/arm-task (bufs/current ws) appending))
          ws (bufs/run-pending-task ws)]
      (is (= ["x" "from the task"] (:lines (bufs/current ws))))
      (is (nil? (:pending-task ws)))
      (is (nil? (:pending-task (bufs/current ws))))))

  (testing "a task may open a buffer -- :buffer-command from a task works like from a command"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          opener (fn [state] (assoc state :buffer-command
                                    {:op :open-new :state (buf/new-state nil ["output"])}))
          ws (bufs/put-current ws (bufs/arm-task (bufs/current ws) opener))
          ws (bufs/run-pending-task ws)]
      (is (= ["output"] (:lines (bufs/current ws))))
      (is (nil? (:pending-task ws)))))

  (testing "the optional after fn sees the task's result, like a post-command hook"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          appending (fn [state] (update state :lines conj "from the task"))
          after (fn [state] (update state :lines conj "after"))
          ws (bufs/put-current ws (bufs/arm-task (bufs/current ws) appending))
          ws (bufs/run-pending-task ws after)]
      (is (= ["x" "from the task" "after"] (:lines (bufs/current ws))))
      (is (nil? (:pending-task ws)))))

  (testing "a task can arm a further task, so the loop chains rather than stalling"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          second-step (fn [state] (update state :lines conj "two"))
          first-step (fn [state] (bufs/arm-task (update state :lines conj "one") second-step))
          ws (bufs/put-current ws (bufs/arm-task (bufs/current ws) first-step))
          ws (bufs/run-pending-task ws)]
      (is (= ["x" "one"] (:lines (bufs/current ws))))
      (is (some? (:pending-task ws)))
      (let [ws (bufs/run-pending-task ws)]
        (is (= ["x" "one" "two"] (:lines (bufs/current ws))))
        (is (nil? (:pending-task ws)))))))

(deftest a-throwing-task-does-not-kill-the-session
  (testing "the error becomes a message, the queue is emptied, the buffer is untouched"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          boom (fn [state] (throw "boom"))
          later (fn [state] (update state :lines conj "should not run"))
          ws (bufs/put-current ws (-> (bufs/current ws)
                                      (bufs/arm-task boom)
                                      (bufs/arm-task later)))
          ws (bufs/run-pending-task ws)]
      (is (= ["x"] (:lines (bufs/current ws))))
      (is (nil? (:pending-task ws)))
      (is (nil? (:pending-task (bufs/current ws))))
      (is (string/includes? (:message (bufs/current ws)) "task error"))
      (is (string/includes? (:message (bufs/current ws)) "boom")))))

(deftest arm-task-queues-two-steps
  (testing "two arms in one state run as two painted steps, both effects apply"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          one (fn [state] (update state :lines conj "one"))
          two (fn [state] (update state :lines conj "two"))
          ws (bufs/put-current ws (-> (bufs/current ws)
                                      (bufs/arm-task one)
                                      (bufs/arm-task two)))]
      (is (vector? (:pending-task ws)))
      (is (= 2 (count (bufs/pending-queue (:pending-task ws)))))
      (let [ws (bufs/run-pending-task ws)]
        (is (= ["x" "one"] (:lines (bufs/current ws))))
        (is (fn? (:pending-task ws)))
        (let [ws (bufs/run-pending-task ws)]
          (is (= ["x" "one" "two"] (:lines (bufs/current ws))))
          (is (nil? (:pending-task ws))))))))

(deftest a-continuation-runs-before-the-rest-of-the-queue
  (testing "a task that arms another prepends, then the already-queued remainder"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          two (fn [state] (update state :lines conj "two"))
          one (fn [state] (bufs/arm-task (update state :lines conj "one") two))
          three (fn [state] (update state :lines conj "three"))
          ws (bufs/put-current ws (-> (bufs/current ws)
                                      (bufs/arm-task one)
                                      (bufs/arm-task three)))
          ws (bufs/run-pending-task ws)]
      (is (= ["x" "one"] (:lines (bufs/current ws))))
      (is (= 2 (count (bufs/pending-queue (:pending-task ws)))))
      (let [ws (bufs/run-pending-task ws)]
        (is (= ["x" "one" "two"] (:lines (bufs/current ws))))
        (is (fn? (:pending-task ws)))
        (let [ws (bufs/run-pending-task ws)]
          (is (= ["x" "one" "two" "three"] (:lines (bufs/current ws))))
          (is (nil? (:pending-task ws))))))))

(defn- delivered-job [value then]
  (let [p (promise)]
    (deliver p value)
    {:promise p :then then :label "t"}))

(deftest drain-jobs-applies-realized-promises
  (testing "a delivered job's :then runs and the job is removed"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          then (fn [state outcome] (update state :lines conj (:ok outcome)))
          ws (bufs/put-current ws (bufs/add-job (bufs/current ws)
                                                (delivered-job {:ok "hi"} then)))
          ws (bufs/drain-jobs ws)]
      (is (= ["x" "hi"] (:lines (bufs/current ws))))
      (is (not (bufs/jobs-running? ws)))
      (is (nil? (:async-jobs (bufs/current ws))))))

  (testing "an undelivered promise survives drain and does not block"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          p (promise)
          then (fn [state outcome] (update state :lines conj "nope"))
          ws (bufs/put-current ws (bufs/add-job (bufs/current ws)
                                                {:promise p :then then :label "t"}))
          ws (bufs/drain-jobs ws)]
      (is (bufs/jobs-running? ws))
      (is (= ["x"] (:lines (bufs/current ws))))))

  (testing "two jobs: only the realized one applies"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          waiting (promise)
          then-a (fn [state outcome] (update state :lines conj (:ok outcome)))
          then-b (fn [state outcome] (update state :lines conj "late"))
          ws (bufs/put-current ws (-> (bufs/current ws)
                                      (bufs/add-job (delivered-job {:ok "a"} then-a))
                                      (bufs/add-job {:promise waiting :then then-b :label "b"})))
          ws (bufs/drain-jobs ws)]
      (is (= ["x" "a"] (:lines (bufs/current ws))))
      (is (= 1 (count (:async-jobs ws))))))

  (testing "a throwing :then is an echo-area error, not a dead session"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          boom (fn [state outcome] (throw "nope"))
          ws (bufs/put-current ws (bufs/add-job (bufs/current ws)
                                                (delivered-job {:ok 1} boom)))
          ws (bufs/drain-jobs ws)]
      (is (= ["x"] (:lines (bufs/current ws))))
      (is (not (bufs/jobs-running? ws)))
      (is (string/includes? (:message (bufs/current ws)) "task error"))
      (is (string/includes? (:message (bufs/current ws)) "nope"))))

  (testing "an :err outcome is handed to :then"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          then (fn [state outcome]
                 (assoc state :message (str "got " (:err outcome))))
          ws (bufs/put-current ws (bufs/add-job (bufs/current ws)
                                                (delivered-job {:err "boom"} then)))
          ws (bufs/drain-jobs ws)]
      (is (= "got boom" (:message (bufs/current ws)))))))

(deftest spawn-task-does-not-arm-a-blocking-pending-task
  (testing "the editor would still read keys; I/O is a future, not :pending-task"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          io (fn [] :done)
          then (fn [state _outcome] state)
          s (bufs/spawn-task (bufs/current ws) io then "go")]
      (is (nil? (:pending-task s)))
      (is (seq (:async-jobs s)))
      (is (= "go" (:message s)))
      (is (= "go" (:label (first (:async-jobs s))))))))

(deftest discard-jobs-drops-in-flight-work
  (testing "C-g's helper clears the queue without applying"
    (let [p (promise)
          then (fn [state outcome] (update state :lines conj "nope"))
          s (bufs/add-job (buf/new-state nil ["x"])
                          {:promise p :then then :label "t"})
          s (bufs/discard-jobs s)]
      (is (nil? (:async-jobs s)))
      (is (not (bufs/jobs-running? s))))))

(deftest a-finished-job-settles-without-a-keystroke
  (testing "loop-wait after drain is :read-key, so the splice is already on the workspace that main.lg paints"
    ;; paint-then-drain-then-block: the job finishes during :poll's sleep,
    ;; drain applies it, and blocking on read-chord before painting hid the
    ;; splice until the user typed. Drain first; then wait is idle.
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          p (promise)
          then (fn [state outcome] (update state :lines conj (:ok outcome)))
          ws (bufs/put-current ws (bufs/add-job (bufs/current ws)
                                                {:promise p :then then :label "vibing..."}))]
      (is (= :poll (bufs/loop-wait ws)))
      (deliver p {:ok "hi"})
      (let [ws (bufs/drain-jobs ws)]
        (is (= ["x" "hi"] (:lines (bufs/current ws))))
        (is (not (bufs/jobs-running? ws)))
        (is (nil? (:async-jobs (bufs/current ws))))
        (is (= :read-key (bufs/loop-wait ws))))))

  (testing "still in flight -> :poll, so the loop sleeps instead of parking in read-chord"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          p (promise)
          then (fn [state outcome] state)
          ws (bufs/put-current ws (bufs/add-job (bufs/current ws)
                                                {:promise p :then then :label "t"}))]
      (is (= :poll (bufs/loop-wait (bufs/drain-jobs ws))))
      (is (= ["x"] (:lines (bufs/current ws))))))

  (testing "idle, no jobs -> :read-key"
    (is (= :read-key (bufs/loop-wait (bufs/new-workspace (buf/new-state nil ["x"]))))))

  (testing "a blocking pending-task still wins over idle"
    (let [ws (bufs/new-workspace (buf/new-state nil ["x"]))
          ws (bufs/put-current ws (bufs/arm-task (bufs/current ws) (fn [s] s)))]
      (is (= :pending-task (bufs/loop-wait ws))))))
