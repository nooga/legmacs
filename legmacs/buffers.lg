;; legmacs.buffers — a collection of buffers behind the exact same flat
;; state shape legmacs.dispatch/render/commands already expect, so none of
;; them need to know multiple buffers exist.
;;
;; A "workspace" holds every buffer plus the handful of things that are
;; genuinely global rather than per-buffer (the kill-ring, the echo-area
;; message, an open minibuffer/overlay, a pending prefix key -- there's
;; only one of each visible regardless of which buffer you're looking at).
;; `current` merges the active buffer with those shared fields into one
;; flat map; `put-current` splits the result back apart afterward.
;;
;; The one thing a normal (fn [state] -> state) command can't express is
;; "switch to a different buffer" -- there is no different buffer in its
;; view, just the current one. Commands that need to (switch-to-buffer,
;; kill-buffer, find-file opening a second buffer, ...) say so by setting
;; :buffer-command on the state they return, e.g. {:op :switch :id 2}.
;; put-current reads that field and applies it to the workspace, then
;; clears it -- ordinary state, not a side channel.
;;
;; :pending-task is the main-thread serial queue: "do this slow thing, but
;; let the screen catch up first." A command that must run on the editor
;; thread (or that hasn't been split into I/O + apply) returns a message
;; plus {:pending-task (fn [state] -> state)} -- or a vector of such fns.
;; main.lg's loop paints, then runs the head in place of reading a key.
;; arm-task appends; a task that itself arms prepends; a throw is an
;; echo-area message rather than a dead session.
;;
;; :async-jobs is the other half of the same seam: I/O that can run in a
;; goroutine while the user keeps typing. spawn-task starts a future
;; immediately (HTTP, rc, ...); drain-jobs on the main thread applies each
;; realized result through a (fn [state outcome] -> state). Goroutines
;; never touch buffers. The loop drains *before* painting so a just-finished
;; job is visible without a keystroke, then only blocks on read-chord when
;; both queues are empty *and* no user go/future is still live; while
;; jobs (or those spawns) are in flight it peeks term/key-pending? and
;; sleeps a tick. C-g discards in-flight jobs (results dropped, processes
;; not killed). A scratch `(go ...)`/`(future ...)` is not a job --
;; install-spawn-tracking! wraps the natives so the loop still polls
;; instead of parking in read-chord until the user types.
;;
;; Windows (split panes, see legmacs.windows) ride the exact same
;; mechanism. The workspace holds one window tree; each window shows a
;; buffer through its own :view (cursor + scroll). `current` flattens the
;; *active window's* buffer-plus-view; put-current folds the view slice
;; back into that window (and, like any other flat field, into the stored
;; buffer -- so a buffer remembers where you left it and a window newly
;; showing it resumes there). Window commands are just more :buffer-command
;; ops: {:op :split :dir :below}, {:op :other-window}, {:op :delete-window},
;; {:op :delete-other-windows}. The buffer-switching ops (:switch,
;; :open-new, :next, :prev, :help, :append-named) now mean "in the active window";
;; :kill also re-points any window that showed the killed buffer.
;;
;; :current (the active buffer id) is kept in sync with the active
;; window's :buffer after every fold -- one is derived from the other, so
;; the rest of the editor keeps its "there is a current buffer" view of
;; the world.

(ns legmacs.buffers
  (:refer-clojure :exclude [index-of])
  (:require [string]
            [os]
            [legmacs.windows :as win]))

;; Keyboard macro state (:kbd-macro-recording?/:kbd-macro-chords/
;; :last-kbd-macro) is shared, not per-buffer, the same as real Emacs: a
;; macro is a sequence of chords, and replaying one after switching buffers
;; (or windows) is exactly the point of one -- see legmacs.dispatch's
;; recording hook and legmacs.commands' start/end/call-last-kbd-macro.
(def shared-keys [:clipboard :message :minibuffer :pending-prefix :pending-keys :overlay
                   :kbd-macro-recording? :kbd-macro-chords :last-kbd-macro
                   :describe-key? :pending-task :async-jobs :xref-stack])

(defn new-workspace
  "A workspace holding one buffer (id 0, current) shown in one window
   (id 0, active), seeded from `initial-buffer-state`'s own :clipboard
   (everything else shared starts empty)."
  [initial-buffer-state]
  {:buffers {0 initial-buffer-state}
   :order [0]
   :current 0
   :next-id 1
   :windows (win/single 0 0 (win/view-of initial-buffer-state))
   :active-window 0
   :next-window-id 1
   :clipboard (:clipboard initial-buffer-state "")
   :message nil
   :minibuffer nil
   :pending-prefix nil
   :pending-keys []
   :overlay nil
   :describe-key? nil
   :pending-task nil
   :async-jobs nil
   :kbd-macro-recording? false
   :kbd-macro-chords []
   :last-kbd-macro nil
   :quit? false})

(defn- basename
  "The last path segment of `path` -- \"/a/b/c.txt\" -> \"c.txt\" -- so
   buffer names read like Emacs's, not like a full path. Falls back to
   `path` unchanged if it has no separator."
  [path]
  (if-let [i (string/last-index-of path os/file-separator)]
    (subs path (inc i))
    path))

(defn- buffer-base-name [buf]
  (or (:buffer-name buf) (some-> (:filename buf) basename) "*scratch*"))

(defn buffer-list
  "[{:id :name :filename :modified? :mode} ...] in creation/display order.
   Names collide the way Emacs's do -- the first buffer with a given base
   name keeps it, later ones get \"<2>\", \"<3>\", etc."
  [workspace]
  (loop [ids (:order workspace), seen {}, out []]
    (if (empty? ids)
      out
      (let [id (first ids)
            buf (get-in workspace [:buffers id])
            base (buffer-base-name buf)
            n (inc (get seen base 0))
            name (if (= n 1) base (str base "<" n ">"))]
        (recur (rest ids) (assoc seen base n)
               (conj out {:id id :name name :filename (:filename buf)
                          :modified? (:modified? buf) :mode (:mode buf)}))))))

(defn flat-for-window
  "Window `win-id`'s buffer flattened with that window's view (the view
   wins -- it's the authoritative cursor/scroll for that window) and the
   shared fields. What legmacs.render draws any one window from; the
   active window's version of this, plus the command-facing extras, is
   `current`."
  [workspace win-id]
  (let [leaf (win/find-leaf (:windows workspace) win-id)]
    (merge (get-in workspace [:buffers (:buffer leaf)])
           (select-keys workspace shared-keys)
           (:view leaf)
           {:current-buffer-id (:buffer leaf)})))

(defn current
  "The active window's buffer, flattened with the window's view, the
   shared fields, and read-only :buffer-list/:current-buffer-id/
   :window-count, in exactly the shape legmacs.dispatch and
   legmacs.render already expect."
  [workspace]
  (merge (flat-for-window workspace (:active-window workspace))
         {:quit? (:quit? workspace)
          :buffer-list (buffer-list workspace)
          :window-count (count (win/leaf-ids (:windows workspace)))
          :buffer-command nil}))

(defn- index-of [coll x]
  (loop [i 0, xs (seq coll)]
    (cond (empty? xs) nil
          (= (first xs) x) i
          :else (recur (inc i) (rest xs)))))

(defn- cycle-id [workspace delta]
  (let [order (:order workspace)
        n (count order)
        idx (index-of order (:current workspace))]
    (nth order (mod (+ idx delta) n))))

(defn- kill-buffer-op
  "Remove `id`. If that empties the workspace, `fallback` (a fresh
   buffer-state the caller supplies, e.g. a scratch buffer) becomes the
   sole remaining buffer -- a workspace is never left with zero buffers.
   Otherwise, if `id` was current, the buffer that lands in the same slot
   (or the new last slot, if `id` was last) becomes current."
  [workspace id fallback]
  (let [old-order (:order workspace)
        remaining (vec (remove #(= % id) old-order))
        buffers (dissoc (:buffers workspace) id)]
    (if (empty? remaining)
      (let [new-id (:next-id workspace)]
        (-> workspace
            (assoc :buffers {new-id fallback} :order [new-id] :current new-id)
            (update :next-id inc)))
      (assoc workspace
             :buffers buffers
             :order remaining
             :current (if (= id (:current workspace))
                        (nth remaining (min (index-of old-order id) (dec (count remaining))))
                        (:current workspace))))))

(defn- set-window-buffer
  "Point window `wid` at buffer `buf-id`, adopting the view stored on
   that buffer's state -- a buffer remembers where you left it, so a
   window newly showing it resumes there."
  [workspace wid buf-id]
  (let [view (win/view-of (get-in workspace [:buffers buf-id]))]
    (update workspace :windows win/update-leaf wid
            (fn [leaf] (assoc leaf :buffer buf-id :view view)))))

(defn- add-buffer
  "Register `state` as a new buffer at the end of :order. Returns
   [workspace new-id]."
  [workspace state]
  (let [id (:next-id workspace)]
    [(-> workspace
         (assoc-in [:buffers id] state)
         (update :order conj id)
         (update :next-id inc))
     id]))

(defn- appended-buffer-state
  "Append `addition`'s text to an existing generated buffer, separated by a
   blank line, and leave point at the end.  Process output is not a user edit:
   the existing buffer's modified and undo state are deliberately preserved."
  [existing addition]
  (let [old-lines (:lines existing)
        new-lines (:lines addition)
        old-lines (if (= [""] old-lines) [] old-lines)
        lines (vec (concat old-lines (when (seq old-lines) [""]) new-lines))
        row (dec (count lines))]
    (assoc existing
           :lines lines
           :cursor-row row
           :cursor-col (count (nth lines row))
           :goal-col nil)))

(defn- replaced-buffer-state
  "Reuse by replacement: the addition *is* the new content.  What :help
   wants -- help text is regenerated, never accumulated."
  [_existing addition]
  addition)

(defn- find-buffer-by-name
  "The id of the buffer whose :buffer-name is `name`, or nil.  Generated
   buffers (*Help*, a directory listing, dir/+Errors, ...) are singletons
   keyed by that name -- this is the lookup behind every find-or-create op."
  [workspace name]
  (some (fn [id] (when (= name (:buffer-name (get-in workspace [:buffers id]))) id))
        (:order workspace)))

(defn- find-buffer-by-filename [workspace filename]
  (some (fn [id] (when (= filename (:filename (get-in workspace [:buffers id]))) id))
        (:order workspace)))

(defn- place-cursor
  "Put window `wid`'s point at row/col (clamped to its buffer), recentered."
  [workspace wid row col]
  (let [lines (:lines (get-in workspace [:buffers (:buffer (win/find-leaf (:windows workspace) wid))]))
        row (max 0 (min (or row 0) (dec (count lines))))
        col (max 0 (min (or col 0) (count (nth lines row))))]
    (update workspace :windows win/update-leaf wid
            (fn [leaf] (update leaf :view assoc :cursor-row row :cursor-col col
                               :goal-col nil :recenter true)))))

(defn- visit
  "The :visit op: show a buffer in the active window with point at
   :row/:col. The buffer is :id, else the one visiting :filename, else the
   one named :name, else :state is opened as a new one (nil :state and no
   match: nothing happens)."
  [workspace awin cmd]
  (let [id (or (:id cmd)
               (when (:filename cmd) (find-buffer-by-filename workspace (:filename cmd)))
               (when (:name cmd) (find-buffer-by-name workspace (:name cmd))))
        [ws id] (cond id [workspace id]
                      (:state cmd) (add-buffer workspace (:state cmd))
                      :else [workspace nil])]
    (if (and id (contains? (:buffers ws) id))
      (-> (set-window-buffer ws awin id)
          (place-cursor awin (:row cmd) (:col cmd)))
      ws)))

(defn- reuse-named-buffer
  "The find-or-create shape shared by :help and :append-named: focus the
   buffer named (:name cmd) with `reuse-fn` applied to it, or register
   (:state cmd) as a brand-new buffer.  `reuse-fn` is [existing addition ->
   state] and is the *only* difference between the two ops -- replace the
   content (replaced-buffer-state) or append to it (appended-buffer-state)."
  [workspace awin cmd reuse-fn]
  (if-let [existing (find-buffer-by-name workspace (:name cmd))]
    (-> workspace
        (update-in [:buffers existing] reuse-fn (:state cmd))
        (set-window-buffer awin existing))
    (let [[ws id] (add-buffer workspace (:state cmd))]
      (set-window-buffer ws awin id))))

(defn- apply-buffer-command
  "Apply one :buffer-command to the workspace. The buffer-switching ops
   act on the active window; the window ops reshape the tree itself."
  [workspace cmd]
  (let [awin (:active-window workspace)]
    (case (:op cmd)
      :switch (set-window-buffer workspace awin (:id cmd))
      :open-new (let [[ws id] (add-buffer workspace (:state cmd))]
                  (set-window-buffer ws awin id))
      ;; A named, editable output buffer that accumulates blocks over time.
      ;; The Acme extension uses this for directory-scoped +Errors buffers,
      ;; but the operation is intentionally generic process-output plumbing.
      :append-named (reuse-named-buffer workspace awin cmd appended-buffer-state)
      ;; show a buffer (open, or opened from :state) with point at a
      ;; position: goto-definition and its way back
      :visit (visit workspace awin cmd)
      ;; after the kill, every window that showed the dead buffer gets
      ;; re-pointed at whatever buffer kill-buffer-op picked as current
      ;; (or the fresh fallback) -- a window is never left on a buffer
      ;; that no longer exists.
      :kill (let [ws (kill-buffer-op workspace (:id cmd) (:fallback cmd))]
              (update ws :windows win/remap-buffer (:id cmd) (:current ws)
                      (win/view-of (get-in ws [:buffers (:current ws)]))))
      :next (set-window-buffer workspace awin (cycle-id workspace 1))
      :prev (set-window-buffer workspace awin (cycle-id workspace -1))
      ;; :help find-or-create -- a named singleton buffer (e.g. *Help*)
      ;; whose content is (re)filled from :state, then focused. Reusing the
      ;; slot keeps repeated C-h from piling up *Help*<2>, *Help*<3>, ... and
      ;; refreshes stale content, the way Emacs reuses its *Help* buffer.
      :help (reuse-named-buffer workspace awin cmd replaced-buffer-state)
      :split (-> workspace
                 (update :windows win/split-leaf awin (:dir cmd) (:next-window-id workspace))
                 (update :next-window-id inc))
      :other-window (assoc workspace :active-window
                           (win/next-leaf-id (:windows workspace) awin 1))
      ;; refuses to delete the sole window (the command layer messages
      ;; that case; refusing here too keeps the tree valid regardless of
      ;; who sends the op).
      :delete-window (if (> (count (win/leaf-ids (:windows workspace))) 1)
                       (-> workspace
                           (assoc :active-window (win/next-leaf-id (:windows workspace) awin 1))
                           (update :windows win/delete-leaf awin))
                       workspace)
      :delete-other-windows (assoc workspace :windows
                                   (win/find-leaf (:windows workspace) awin))
      workspace)))

(defn- sync-current
  "Re-derive :current (the active buffer id) from the active window --
   the one invariant tying the flat-state world to the window tree."
  [workspace]
  (assoc workspace :current
         (:buffer (win/find-leaf (:windows workspace) (:active-window workspace)))))

(defn put-current
  "Fold `flat-state` (whatever legmacs.dispatch produced) back into
   `workspace`: the current buffer's own fields go back into :buffers,
   the shared fields go back onto the workspace, the view slice goes back
   into the active window, :quit? is read off directly, and a
   :buffer-command (if any) is applied and consumed."
  [workspace flat-state]
  (let [cmd (:buffer-command flat-state)
        stored (apply dissoc flat-state (concat shared-keys [:buffer-command :buffer-list :current-buffer-id :quit? :window-count]))
        workspace (-> workspace
                      (assoc-in [:buffers (:current workspace)] stored)
                      ;; explicit get, not select-keys: a command that
                      ;; *dissoc*s a shared key (e.g. dispatch's overlay
                      ;; dismissal) rather than assoc-ing it to nil would
                      ;; otherwise vanish from select-keys' result and
                      ;; never overwrite the workspace's stale copy --
                      ;; get defaults to nil either way, so both styles
                      ;; of "clear this" actually clear it here.
                      (merge (reduce (fn [m k] (assoc m k (get flat-state k))) {} shared-keys))
                      (assoc :quit? (boolean (:quit? flat-state)))
                      (update :windows win/update-leaf (:active-window workspace)
                              (fn [leaf] (assoc leaf :view (win/view-of flat-state)))))]
    (sync-current (apply-buffer-command workspace cmd))))

;; --- pending-task --------------------------------------------------------
;; Serial queue of (fn [state] -> state). The field holds a fn, a vector of
;; fns, or nil; pending-queue is the only thing that has to know which.

(defn pending-queue
  "Normalize :pending-task (nil, one fn, or a vector of fns) to a vector."
  [x]
  (cond (nil? x) []
        (fn? x) [x]
        (vector? x) x
        :else (vec x)))

(defn- as-pending
  "The canonical stored form: nil, a lone fn, or a vector of 2+."
  [q]
  (let [q (vec q)
        n (count q)]
    (cond (zero? n) nil
          (= 1 n) (first q)
          :else q)))

(defn arm-task
  "Append `f` (fn [state] -> state) onto state's :pending-task queue.
   A single arm stays a bare fn (so existing fn? checks still hold); a
   second arm promotes the field to a vector. Optional `message` is what
   the next painted frame should show before the head runs."
  ([state f] (arm-task state f nil))
  ([state f message]
   (let [state (assoc state :pending-task
                      (as-pending (conj (pending-queue (:pending-task state)) f)))]
     (if message
       (assoc state :message message)
       state))))

(defn- task-error-line
  "Collapse an exception into something the one-line echo area can show."
  [e]
  (let [s (string/replace (str (or (ex-message e) e)) "\n" " ")]
    (if (> (count s) 200) (str (subs s 0 200) "...") s)))

(defn- task-failed-state [state e]
  (assoc state :pending-task nil :message (str "task error: " (task-error-line e))))

(defn- finish-pending-step
  "Run `after` on the task's result, then put any newly-armed work *in
   front of* `remaining` (a continuation before the rest of the queue)."
  [workspace after remaining state*]
  (let [state* (after state*)
        state* (assoc state* :pending-task
                      (as-pending (into (pending-queue (:pending-task state*)) remaining)))]
    (put-current workspace state*)))

(defn run-pending-task
  "One loop step: consume the queue, run the head, fold the result back.
   `after` (default identity) is threaded over the task's returned state
   before the remainder is restored -- main.lg passes
   dispatch/run-after-commands so a task gets the same post-command
   hooks a keystroke does, without this ns requiring dispatch.

   Consume happens on the flat state *before* the call, so a throw cannot
   retry the same head; the catch reports it and drops the rest of the
   queue rather than killing the session."
  ([workspace] (run-pending-task workspace identity))
  ([workspace after]
   (let [q (pending-queue (:pending-task workspace))]
     (if (empty? q)
       workspace
       (let [f (first q)
             remaining (vec (rest q))
             state (assoc (current workspace) :pending-task nil)]
         (try
           (finish-pending-step workspace after remaining (f state))
           (catch e
             (put-current workspace (task-failed-state state e)))))))))

;; --- async-jobs ----------------------------------------------------------
;; I/O in a future, apply on the main thread. Each job is
;; {:promise p :then (fn [state outcome] -> state) :label "..."}.
;; outcome is {:ok v} or {:err e} -- let-go's future delivers nil on throw,
;; so job-outcome wraps the io thunk.

(defn- job-list [x]
  (vec (or x [])))

(defn- as-jobs [jobs]
  (let [jobs (job-list jobs)]
    (if (empty? jobs) nil jobs)))

(defn jobs-running?
  "True if `m` (workspace or flat state) has any in-flight async jobs."
  [m]
  (boolean (seq (:async-jobs m))))

(defn add-job
  "Append a job map onto state's :async-jobs. The caller supplies the
   promise (tests); spawn-task is the one that starts a future."
  [state job]
  (assoc state :async-jobs (conj (job-list (:async-jobs state)) job)))

(defn discard-jobs
  "Drop in-flight jobs without applying. Goroutines still finish; the
   results are ignored. C-g uses this -- it does not kill HTTP/os/sh."
  [state]
  (assoc state :async-jobs nil))

(defn- job-outcome
  "Run `io` (fn [] -> value) and box the result so a throw cannot vanish
   as a nil delivery from future*."
  [io]
  (try {:ok (io)} (catch e {:err e})))

(defn spawn-task
  "Start `io` (fn [] -> value) in a future and record a job whose `:then`
   (fn [state outcome] -> state) will run on the main thread when the
   promise realizes. Optional `message` is the echo-area line for the
   next paint; the modeline also shows in-flight labels. Does not arm
   :pending-task -- the editor keeps reading keys."
  ([state io then] (spawn-task state io then nil))
  ([state io then message]
   (let [p (future (job-outcome io))
         state (add-job state {:promise p :then then :label message})]
     (if message
       (assoc state :message message)
       state))))

(defn- apply-one-job
  "Deref a realized job and run its :then. A throw becomes an echo-area
   message; the job is still dropped by the caller."
  [state job]
  (try
    ((:then job) state (deref (:promise job)))
    (catch e
      (assoc state :message (str "task error: " (task-error-line e))))))

(defn- job-realized? [job]
  (boolean (realized? (:promise job))))

(defn- job-waiting? [job]
  (not (job-realized? job)))

(defn drain-jobs
  "Apply every realized job's :then on the current buffer, leave the
   rest in flight. `after` (default identity) is the same post-command
   hook main.lg passes to run-pending-task. Newly spawned jobs from a
   :then stay; a throw in :then drops that job and continues with the
   others."
  ([workspace] (drain-jobs workspace identity))
  ([workspace after]
   (let [jobs (job-list (:async-jobs workspace))]
     (if (empty? jobs)
       workspace
       (let [realized (filterv job-realized? jobs)
             waiting (filterv job-waiting? jobs)]
         (if (empty? realized)
           workspace
           (let [state (assoc (current workspace) :async-jobs (as-jobs waiting))
                 state (reduce apply-one-job state realized)
                 state (after state)
                 state (assoc state :async-jobs (as-jobs (:async-jobs state)))]
             (put-current workspace state))))))))

;; --- user go/future tracking ---------------------------------------------
;; spawn-task is the blessed async path, but C-x C-e of (go ...) / (future ...)
;; from *scratch* is the one people actually type. Those natives return at
;; once; without a job on :async-jobs the loop would then park in
;; read-chord, so a background println fights the TTY and a live modeline
;; never repaints. Counting live spawns lets loop-wait keep polling.

(def ^:private live-spawns (atom 0))
(def ^:private spawn-tracking-installed? (atom false))

(defn live-spawns?
  "True when a go*/future* started after install-spawn-tracking! is still
   running. Independent of :async-jobs -- a scratch (go (loop ...)) never
   becomes a job."
  []
  (pos? @live-spawns))

(defn- tracked-body
  "Thunk wrapper: run `thunk`, then drop the live-spawn count. Reifies the
   outcome so a throw still decrements -- let-go's finally cannot both
   clean up and propagate (see CLAUDE.md)."
  [thunk]
  (fn []
    (let [outcome (try {:ok (thunk)} (catch e {:err e}))]
      (swap! live-spawns dec)
      (if (contains? outcome :err)
        (throw (:err outcome))
        (:ok outcome)))))

(defn- make-tracked-spawn
  "A (fn [thunk] ...) that incs the live count and calls `orig` (the real
   go*/future*) with a wrapper that decs when the body returns. Own named
   fn so install-spawn-tracking!'s `when-not` contains calls, not capturing
   fn literals (let-go AOT hoist, nooga/let-go#766)."
  [orig]
  (fn [thunk]
    (swap! live-spawns inc)
    (orig (tracked-body thunk))))

(defn- replace-spawn-var!
  "Point `v` at a tracking wrapper around `orig`. constantly + named
   make-tracked-spawn, not an fn form in a conditional."
  [v orig]
  (alter-var-root v (constantly (make-tracked-spawn orig))))

(def exit-hooks
  "name -> (fn [] ...) run once as the editor exits, after the terminal is
   restored. For resources that must not outlive the editor -- a jacked-in
   nREPL server process, for one."
  (atom {}))

(defn add-exit-hook!
  "Register (or replace) the exit hook called `name`."
  [name f]
  (swap! exit-hooks assoc name f)
  name)

(defn run-exit-hooks!
  "Run every exit hook; a throwing hook doesn't stop the others."
  []
  (doseq [f (vals @exit-hooks)]
    (try (f) (catch e nil))))

(defn install-spawn-tracking!
  "Wrap go* and future* so loop-wait can poll while they run. Idempotent.
   async/go* is a copy of the native taken at boot, not the core var, so
   it is wrapped separately with the same original."
  []
  (when-not @spawn-tracking-installed?
    (replace-spawn-var! #'future* future*)
    (let [orig-go* go*]
      (replace-spawn-var! #'go* orig-go*)
      (when-let [av (find-var 'async/go*)]
        (replace-spawn-var! av orig-go*)))
    (reset! spawn-tracking-installed? true))
  true)

(defn loop-wait
  "What the editor should do after painting `workspace`. Drain realized
   jobs *before* asking this -- otherwise a just-finished job stays on
   screen until the next keystroke (paint, drain, then block on read-chord).

   :quit          -- leave the loop
   :pending-task  -- run the main-thread queue head (already painted)
   :poll          -- jobs or user go/future still in flight; peek stdin or sleep
   :read-key      -- idle; block on the next chord"
  [workspace]
  (cond
    (:quit? workspace) :quit
    (:pending-task workspace) :pending-task
    (jobs-running? workspace) :poll
    (live-spawns?) :poll
    :else :read-key))
