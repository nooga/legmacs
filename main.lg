;; legmacs — a small terminal text editor, scriptable in let-go.
;;
;; Usage:
;;   lg main.lg [file]
;;
;; or, installed via bin/legmacs (which arranges for ~/.config/legmacs/ to be
;; on the namespace search path so legmacs-init.lg gets picked up):
;;
;;   legmacs [file]

(ns legmacs.main
  (:require [term]
            [os]
            [string]
            [legmacs.buffer :as buf]
            [legmacs.keys :as keys]
            [legmacs.keymap :as km]
            [legmacs.commands :as commands]
            [legmacs.bindings :as bindings]
            [legmacs.modes :as modes]
            [legmacs.modes.letgo]
            [legmacs.modes.repl]
            [legmacs.modes.markdown]
            [legmacs.modes.prog]
            [legmacs.modes.structural]
            [legmacs.modes.comment]
            [legmacs.modes.crutch]
            [legmacs.modes.keycast]
            [legmacs.modes.help]
            [legmacs.modes.letgo-complete]
            [legmacs.nrepl]
            [legmacs.jack-in]
            ;; :refer, not just :as -- (vibe "...") typed into a buffer is
            ;; read and evaluated *in this namespace* (see legmacs.modes.letgo's
            ;; docstring). vibe.lg also intern's `vibe` into let-go.core so a
            ;; later `(ns foo)` still resolves it unqualified (C-c C-v / C-x C-e).
            [legmacs.vibe :refer [vibe]]
            [legmacs.dispatch :as dispatch]
            [legmacs.render :as render]
            [legmacs.buffers :as bufs]))

(def fallback-size [80 24])

(defn- term-size []
  (let [[cols rows] (or (term/size) fallback-size)]
    (if (and (pos? cols) (pos? rows)) [cols rows] fallback-size)))

;; CSI ?2004h/l -- bracketed paste mode. Wraps a terminal paste in ESC[200~
;; ... ESC[201~ instead of replaying it as ordinary keystrokes; see
;; legmacs.keys' handling of those markers for why that matters. Built with
;; (char 27) rather than a \033-style escape in source -- let-go's reader
;; only understands \t \r \n \b \f \\ \" and \uXXXX, not octal escapes (see
;; legmacs.keys' own docstring on this exact trap).
(def ^:private ESC (str (char 27)))
(def ^:private enable-bracketed-paste (str ESC "[?2004h"))
(def ^:private disable-bracketed-paste (str ESC "[?2004l"))

(defn init-terminal! []
  (when (nil? (term/size))
    (println "legmacs: stdin/stdout must be a terminal.")
    (os/exit 1))
  (term/raw-mode!)
  (term/alternate-screen)
  (term/clear)
  (term/write enable-bracketed-paste)
  (term/flush))

(defn shutdown-terminal! []
  (term/write disable-bracketed-paste)
  (term/reset-style)
  (term/show-cursor)
  (term/main-screen)
  (term/flush)
  (term/restore-mode!))

(def scratch-banner
  [";; *scratch* -- a let-go-mode buffer."
   ";; C-x C-e evaluates the sexp before point and shows the result below."
   ";; C-j evaluates it and inserts the result right here, REPL-transcript"
   ";; style. C-c C-e evaluates the whole buffer."
   ""])

(defn load-file-or-scratch [path]
  (if path
    (first (commands/new-file-state path))
    (-> (buf/new-state nil scratch-banner)
        (modes/switch-to-mode :let-go)
        (assoc :default-directory (os/cwd))
        (assoc :cursor-row (dec (count scratch-banner))))))

(defn- load-user-config! []
  ;; legmacs-init is an ordinary namespace -- if the namespace search path
  ;; (LG_SOURCE_PATHS, see bin/legmacs) includes a directory with
  ;; legmacs_init.lg or legmacs-init.lg, its top-level forms (typically
  ;; legmacs.keymap/bind-key! and legmacs.keymap/defcommand calls) run now,
  ;; after the defaults are installed, so user bindings win.
  (try
    (require 'legmacs-init)
    (catch e nil)))

(defn render! [workspace]
  (let [[cols rows] (term-size)
        workspace (render/prepare-workspace workspace cols rows)]
    (term/write (render/workspace-frame workspace cols rows))
    (term/flush)
    workspace))

(def ^:private job-poll-ms 20)

(defn- handle-chord
  "Block for one key (or take one that's already pending) and dispatch it."
  [workspace]
  (let [chord (keys/read-chord)]
    (if (nil? chord)
      (assoc workspace :quit? true)
      (bufs/put-current workspace (dispatch/dispatch (bufs/current workspace) chord)))))

(defn run
  "Threads a workspace (see legmacs.buffers) rather than a single flat
   buffer state, so multiple buffers and windows can exist -- but dispatch
   still only ever sees the flat, current-window view; workspace-level
   bookkeeping (switching, opening, killing, splitting) happens in the
   fold back via bufs/put-current, driven by whatever :buffer-command a
   command set. render! draws every window but likewise returns just a
   workspace with per-window scroll positions brought up to date.

   drain-jobs applies any futures that have finished *before* the frame
   is painted, so a splice shows up without waiting for a keystroke. A
   :pending-task still takes the place of reading a key for one iteration
   -- main-thread work that asked to paint first. While :async-jobs are
   in flight -- or a scratch go/future is still live -- the loop peeks
   term/key-pending? instead of parking in read-chord, so typing continues
   and the frame keeps being painted (a background println cannot sit on
   the TTY until the next key). A short sleep avoids a busy-spin until
   the next completion or keystroke. Idle (no jobs, no live spawns, no
   pending-task) is a blocking read-chord."
  [workspace]
  (loop [workspace workspace]
    (let [workspace (bufs/drain-jobs workspace dispatch/run-after-commands)
          workspace (render! workspace)]
      (case (bufs/loop-wait workspace)
        :quit workspace
        :pending-task (recur (bufs/run-pending-task workspace dispatch/run-after-commands))
        :poll (if (term/key-pending?)
                (recur (handle-chord workspace))
                (do (sleep job-poll-ms) (recur workspace)))
        :read-key (recur (handle-chord workspace))))))

(defn- open-additional-buffer [workspace path]
  (bufs/put-current workspace
                     (assoc (bufs/current workspace)
                            :buffer-command {:op :open-new :state (first (commands/new-file-state path))})))

(defn build-workspace
  "One buffer per command-line file argument (like `emacs a.txt b.txt`),
   with the first one focused -- the rest are just open, reachable with
   C-x b. No arguments at all -> the *scratch* buffer."
  [paths]
  (let [initial-state (load-file-or-scratch (first paths))
        workspace (reduce open-additional-buffer (bufs/new-workspace initial-state) (rest paths))]
    ;; a real :switch op, not a bare (assoc :current 0) -- the active
    ;; window has to come along to buffer 0 too, and put-current is the
    ;; one place that knows how to keep the two in step.
    (bufs/put-current workspace
                      (assoc (bufs/current workspace) :buffer-command {:op :switch :id 0}))))

(defn main []
  (bindings/install!)
  (bufs/install-spawn-tracking!)
  (load-user-config!)
  (let [workspace (build-workspace *command-line-args*)]
    (init-terminal!)
    (try
      (run workspace)
      (finally
        (shutdown-terminal!)
        (bufs/run-exit-hooks!)))))

;; Guard the launch so AOT compilation (`lg -c` / `lg -b`, which set
;; *compiling-aot* true before running top-level forms to harvest the
;; namespace chunks into a bundle) doesn't start the interactive editor.
;; At real startup the flag is false, so the bundled binary boots normally.
(when-not *compiling-aot* (main))
