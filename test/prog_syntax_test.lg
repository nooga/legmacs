(ns test.prog-syntax-test
  (:require [test :refer :all]
            [string]
            [legmacs.prog-syntax :as ps]))

(def go-spec
  {:line-comments ["//"]
   :block-comment ["/*" "*/"]
   :string-delims ["\"" "'" "`"]})

(def json-spec
  {:string-delims ["\""]})

(def lua-spec
  {:line-comments ["--"]
   :block-comment ["--[[" "]]"]
   :string-delims ["\"" "'"]})

(deftest basic-matching
  (testing "nested brackets all match correctly, both directions"
    (let [text "func(a, [x], {y}) {}"
          s (ps/scan text go-spec)]
      (is (= (string/index-of text ")") (ps/matching s (string/index-of text "("))))
      (is (= (string/index-of text "]") (ps/matching s (string/index-of text "["))))
      (is (= (string/last-index-of text "}") (ps/matching s (string/last-index-of text "{")))))))

(deftest line-comments-are-skipped
  (testing "a paren inside a // comment doesn't count as structure"
    (let [text "(a) // comment (fake paren)\n(b)"
          s (ps/scan text go-spec)
          second-open (string/last-index-of text "(")]
      (is (= (string/index-of text ")") (ps/matching s 0)))
      (is (= (dec (count text)) (ps/matching s second-open)))
      (is (= 1 (count (:spans s))))
      (is (= :comment (:type (first (:spans s))))))))

(deftest block-comments
  (testing "a block comment closed on the same line doesn't break structure across it"
    (let [text "(a /* (fake) */ b)"
          s (ps/scan text go-spec)]
      (is (= (dec (count text)) (ps/matching s 0)))))

  (testing "an unterminated block comment reports :in-comment? at the cutoff"
    (let [text "/* still open"
          s (ps/scan text (count text) go-spec)]
      (is (:in-comment? s))
      (is (not (:in-string? s)))))

  (testing "a block comment closed exactly at the cutoff is not :in-comment?"
    (let [text "/* done */"
          s (ps/scan text (count text) go-spec)]
      (is (not (:in-comment? s))))))

(deftest strings-with-multiple-delimiters
  (testing "double, single, and backtick delimiters all skip structure inside them"
    (is (= (dec (count "(\"str)\")")) (ps/matching (ps/scan "(\"str)\")" go-spec) 0)))
    (is (= (dec (count "('str)')")) (ps/matching (ps/scan "('str)')" go-spec) 0)))
    (is (= (dec (count "(`str)`)")) (ps/matching (ps/scan "(`str)`)" go-spec) 0))))

  (testing "backslash escapes inside strings are honored"
    (let [text "(a \"str ) with \\\" escaped quote\" b)"]
      (is (= (dec (count text)) (ps/matching (ps/scan text go-spec) 0)))))

  (testing "in-string? distinguishes an open string from one closed exactly at the cutoff"
    (is (:in-string? (ps/scan "\"unterminated" 13 go-spec)))
    (is (not (:in-string? (ps/scan "\"foo\"" 5 go-spec))))))

(deftest block-comment-open-marker-wins-over-a-prefix-line-comment-marker
  (testing "Lua's \"--[[\" is checked before the plain \"--\" line comment it's a prefix of"
    (let [text "f(--[[ (fake) ]] a)"
          s (ps/scan text lua-spec)]
      (is (= (dec (count text)) (ps/matching s 1)))))

  (testing "a bare \"--\" with no following [[ is still an ordinary line comment"
    (let [text "f(a) -- (b)\nf(c)"
          s (ps/scan text lua-spec)]
      (is (= (string/index-of text ")") (ps/matching s 1)))
      (is (= (dec (count text)) (ps/matching s (string/last-index-of text "(")))))))

(deftest depth-at-tracks-currently-open-brackets
  (testing "depth grows with unmatched opens before point, ignoring closed ones"
    (let [text "func foo(x) {\n  if (x) {"]
      (is (= 0 (ps/depth-at text 0 go-spec)))
      (is (= 2 (ps/depth-at text (count text) go-spec))))))

(deftest json-spec-has-no-comments-or-brackets-override
  (testing "an empty :line-comments list never matches, default brackets still apply"
    (let [text "{\"a\": [1, 2]}"
          s (ps/scan text json-spec)]
      (is (= (dec (count text)) (ps/matching s 0)))
      (is (= (string/index-of text "]") (ps/matching s (string/index-of text "[")))))))

(deftest point-in-string-or-comment?-cases
  (testing "inside an open string at the cutoff"
    (is (ps/point-in-string-or-comment? (ps/scan "\"foo" 4 go-spec) 4)))
  (testing "inside an open block comment at the cutoff"
    (is (ps/point-in-string-or-comment? (ps/scan "/* foo" 6 go-spec) 6)))
  (testing "inside a line comment at the cutoff"
    (is (ps/point-in-string-or-comment? (ps/scan "// foo" 6 go-spec) 6)))
  (testing "top level is not in a string or comment"
    (is (not (ps/point-in-string-or-comment? (ps/scan "(foo)" 5 go-spec) 5)))))

(deftest bracket-predicates
  (testing "open-bracket?/close-bracket?/close-for use the spec's bracket map, defaulting to the standard three pairs"
    (is (ps/open-bracket? go-spec \())
    (is (ps/close-bracket? go-spec \)))
    (is (not (ps/open-bracket? go-spec \x)))
    (is (= \) (ps/close-for go-spec \()))))

(def py-spec
  {:line-comments ["#"]
   :multiline-strings [{:open "\"\"\"" :close "\"\"\"" :escape? true}]
   :string-delims ["\"" "'"]})

(def raw-go-spec
  (assoc go-spec
         :string-delims ["\"" "'"]
         :multiline-strings [{:open "`" :close "`" :escape? false}]))

(deftest multiline-strings-hide-structure-across-lines
  (testing "brackets inside a Go raw string are text, not structure"
    (let [text "func f() {\n\tq := `a ( b [ c`\n}"
          s (ps/scan text raw-go-spec)]
      ;; the { still matches its }, and the ( inside the raw string doesn't
      ;; leave anything on the stack
      (is (= (string/last-index-of text "}") (ps/matching s (string/index-of text "{"))))
      (is (empty? (:stack s)))))

  (testing "an unclosed raw string reports itself as still open at point"
    (let [text "q := `open\nstill open"
          s (ps/scan text (count text) raw-go-spec)]
      (is (true? (:in-string? s)))))

  (testing "a triple-quoted docstring's brackets are text too"
    (let [text "def f():\n    \"\"\"a ( b\n    c )\"\"\"\n    return (1)"
          s (ps/scan text py-spec)]
      ;; only def f()'s pair and return (1)'s -- the ( ) inside the
      ;; docstring never reach the bracket stack
      (is (= 2 (count (filter (fn [[k v]] (< k v)) (:pairs s)))))
      (is (nil? (ps/matching s (string/index-of text "( b")))))))

(deftest a-plain-string-delimiter-stops-at-end-of-line
  (testing "one stray quote doesn't swallow the rest of the buffer"
    (let [text "s = \"oops\nfunc f() { }\n"
          s (ps/scan text go-spec)]
      ;; the { } on the next line still matches -- it isn't string content
      (is (= (string/index-of text "}") (ps/matching s (string/index-of text "{"))))
      (is (false? (:in-string? s)))))

  (testing "point inside the unterminated string is still reported as inside it"
    (let [text "s = \"oops\nfunc f() { }\n"
          upto (string/index-of text "oops")
          s (ps/scan text upto go-spec)]
      (is (true? (:in-string? s))))))

;; --- the lean passes (what runs on every keystroke) ---------------------
;;
;; open-stack-at, depth-at, match-for-closer and
;; point-in-string-or-comment-at? all answer questions `scan` can answer
;; too, without building its bracket-pair map and span vector. These pin
;; them to the same answers.

(deftest open-stack-at-matches-scans-stack
  (testing "same brackets, same order, on code with strings and comments in it"
    (doseq [text ["func f() { if (x) { y[0]"
                  "a { b // ) } \n c ("
                  "s := \"({[\" ; ("
                  "/* { ( */ {"
                  "plain code, no brackets"]]
      (is (= (:stack (ps/scan text (count text) go-spec))
             (:stack (ps/open-stack-at text (count text) go-spec)))
          text)))

  (testing "depth-at agrees with counting that stack"
    (doseq [text ["func f() { if (x) {" "{}{}{" "\"({\" (" "// {\n{"]]
      (is (= (count (:stack (ps/scan text (count text) go-spec)))
             (ps/depth-at text (count text) go-spec))))))

(deftest match-for-closer-agrees-with-the-full-scan
  (testing "a closer's match is the bracket it closes"
    (let [text "func f() { g(x); }"]
      (is (= (string/index-of text "(")
             (ps/match-for-closer text (string/index-of text ")") go-spec)))
      (is (= (string/index-of text "{")
             (ps/match-for-closer text (string/last-index-of text "}") go-spec)))))

  (testing "a closer inside a string or comment closes nothing"
    (let [text "f(\"a)b\")"]
      ;; the ) inside the string
      (is (nil? (ps/match-for-closer text 4 go-spec)))
      ;; ...but the real one still matches
      (is (= 1 (ps/match-for-closer text 7 go-spec))))
    (is (nil? (ps/match-for-closer "x // )" 5 go-spec))))

  (testing "a closer with nothing open in front of it"
    (is (nil? (ps/match-for-closer ")" 0 go-spec))))

  (testing "the wrong kind of closer doesn't match"
    (is (nil? (ps/match-for-closer "(]" 1 go-spec)))))

(deftest point-in-string-or-comment-at?-matches-the-scan-based-check
  (testing "the same answer as point-in-string-or-comment? over a full scan"
    (doseq [[text offset] [["\"foo" 4] ["/* foo" 6] ["// foo" 6] ["(foo)" 5]
                           ["\"done\" " 7] ["x // c\ny" 8] ["a \"b" 3]]]
      (is (= (boolean (ps/point-in-string-or-comment? (ps/scan text offset go-spec) offset))
             (boolean (ps/point-in-string-or-comment-at? text offset go-spec)))
          (str (pr-str text) " @" offset))))

  (testing "point right after a string's closing quote is code again"
    (is (not (ps/point-in-string-or-comment-at? "s := \"x\"" 8 go-spec))))

  (testing "point inside an unterminated string is not"
    (is (ps/point-in-string-or-comment-at? "s := \"x" 7 go-spec))))
